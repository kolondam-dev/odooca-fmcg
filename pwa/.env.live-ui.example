# Copy to .env.live-ui.local, then fill these values only in that ignored file.
# Remote runs read URLs from demo-ui Variables and credentials from demo-ui Secrets.
# Never commit target URLs or credentials to this template.
LIVE_UI_ODOO_URL=
LIVE_UI_PWA_URL=
ODOO_DEMO_LOGIN=
ODOO_DEMO_PASSWORD=

# Optional when the Odoo login page exposes a database selector.
# ODOO_DEMO_DB=railway

# Optional browser and execution settings.
# LIVE_UI_CHROMIUM_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# LIVE_UI_IGNORE_HTTPS_ERRORS=NO
# LIVE_UI_TRACE=NO
# LIVE_UI_TIMEOUT_MS=60000
# LIVE_UI_ROUTE_FILE=tests/live-local/routes.json

# Set YES only for an anonymous health/login-page probe without credentials.
# LIVE_UI_PUBLIC_ONLY=YES

# Custom specs must call requireWriteOptIn() before a mutating scenario.
LIVE_UI_ALLOW_WRITE=NO
