{
  "name": "@odooca/fmcg-field",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --mode production",
    "build:demo": "vite build --mode demo",
    "check:build": "node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "contracts:export": "node scripts/export-contracts.mjs",
    "contracts:check": "node scripts/export-contracts.mjs --check",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"hosting/*.mjs\" \"*.ts\" package.json",
    "test:hosting": "node --test hosting/server.test.mjs",
    "start": "node hosting/server.mjs",
    "build:staging": "vite build --mode staging"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@phosphor-icons/core": "2.1.1",
    "idb": "8.0.3",
    "leaflet": "1.9.4",
    "preact": "11.0.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.10.1",
    "fake-indexeddb": "6.2.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "LGPL-3.0-only"
}
