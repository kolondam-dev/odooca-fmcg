<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_sheet_generate_form" model="ir.ui.view">
        <field name="name">id.collection.sheet.generate.form</field>
        <field name="model">id.collection.sheet.generate</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="collect_date"/>
                        <field name="due_until"/>
                    </group>
                    <group>
                        <field name="collector_id"/>
                        <field name="route"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not warning">
                    <field name="warning" nolabel="1"/>
                </div>
                <group>
                    <field name="currency_id" invisible="True"/>
                    <field name="candidate_count"/>
                    <field name="candidate_total"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate SJP" class="btn-primary"/>
                    <button string="Batal" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_collection_sheet_generate" model="ir.actions.act_window">
        <field name="name">Generate SJP</field>
        <field name="res_model">id.collection.sheet.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
