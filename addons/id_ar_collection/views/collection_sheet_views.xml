<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_sheet_list" model="ir.ui.view">
        <field name="name">id.collection.sheet.list</field>
        <field name="model">id.collection.sheet</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="collect_date"/>
                <field name="due_until"/>
                <field name="collector_id"/>
                <field name="route"/>
                <field name="line_count"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_collection_sheet_form" model="ir.ui.view">
        <field name="name">id.collection.sheet.form</field>
        <field name="model">id.collection.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_issue" type="object" string="Terbitkan" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="%(action_report_collection_sheet)d" type="action" string="Cetak SJP"
                            invisible="state in ('draft', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Batalkan"
                            invisible="state not in ('draft', 'issued')"
                            confirm="Batalkan SJP ini? Faktur kembali ke daftar kandidat."/>
                    <button name="action_draft" type="object" string="Kembalikan ke Draf"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued,returned,reconciled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="collector_id" readonly="state != 'draft'"/>
                            <field name="route" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="collect_date" readonly="state != 'draft'"/>
                            <field name="due_until" readonly="state != 'draft'"/>
                            <field name="generated_by"/>
                            <field name="currency_id" invisible="True"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Faktur">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="move_id"/>
                                    <field name="commercial_partner_id"/>
                                    <field name="due_date"/>
                                    <field name="amount_due"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="outcome" readonly="True"/>
                                    <field name="collected_amount" readonly="True"/>
                                    <field name="document_return" readonly="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_collection_sheet_search" model="ir.ui.view">
        <field name="name">id.collection.sheet.search</field>
        <field name="model">id.collection.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="collector_id"/>
                <field name="route"/>
                <filter name="draft" string="Draf" domain="[('state', '=', 'draft')]"/>
                <filter name="issued" string="Diterbitkan" domain="[('state', '=', 'issued')]"/>
                <group>
                    <filter name="by_collector" string="Kolektor" context="{'group_by': 'collector_id'}"/>
                    <filter name="by_date" string="Tanggal" context="{'group_by': 'collect_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_collection_sheet" model="ir.actions.act_window">
        <field name="name">Surat Jalan Penagihan</field>
        <field name="res_model">id.collection.sheet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
