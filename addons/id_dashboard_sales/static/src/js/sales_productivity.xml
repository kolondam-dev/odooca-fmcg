<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="id_dashboard_sales.SalesProductivity">
        <div class="o_action id-sp id-dashboard-workspace">
            <div class="id-sp__sheet">
                <!-- Header & Unified Grouped Filter Bar -->
                <header class="id-sp__header">
                    <div class="id-sp__header-main">
                        <div class="id-sp__header-title-wrap">
                            <span class="id-sp__badge-dept"><i class="fa fa-briefcase"/> PENJUALAN</span>
                            <h1 class="id-sp__title">Kinerja Penjualan</h1>
                            <span class="id-sp__subtitle">Monitoring efektivitas omzet, kepatuhan kunjungan rute PJP, dan penetrasi produk FMCG.</span>
                        </div>
                        <div class="id-sp__header-status">
                            <span class="id-sp__period-pill"><i class="fa fa-calendar"/> <t t-out="periodLabel"/></span>
                        </div>
                    </div>

                    <!-- 3 Logical Filter Clusters -->
                    <details class="dashboard-filters"><summary>Filter · Salesperson: <t t-out="state.salesmanIds.length || 'Semua'"/> · Channel: <t t-out="state.channelIds.length || 'Semua'"/></summary><div class="id-sp__filter-bar">
                        <!-- Cluster 1: Time & Period -->
                        <div class="id-sp__filter-cluster">
                            <span class="id-sp__cluster-label"><i class="fa fa-clock-o"/> Periode Waktu</span>
                            <div class="id-sp__cluster-content">
                                <div class="id-sp__seg" role="group">
                                    <t t-foreach="modes" t-as="m" t-key="m.key">
                                        <button type="button" class="id-sp__seg-btn"
                                                t-att-class="{'is-active': state.mode === m.key}"
                                                t-on-click="() => this.setMode(m.key)" t-out="m.label"/>
                                    </t>
                                </div>
                                <div class="id-sp__date-nav">
                                    <button type="button" class="id-sp__icon-btn" title="Previous" aria-label="Previous"
                                            t-att-disabled="!canPrev" t-on-click="() => this.shift(-1)"><i class="fa fa-chevron-left"/></button>
                                    <input type="date" class="id-sp__input" t-att-value="state.anchor"
                                           t-att-min="state.filters.period_min" t-att-max="state.filters.period_max"
                                           t-on-change="setAnchor"/>
                                    <button type="button" class="id-sp__icon-btn" title="Next" aria-label="Next"
                                            t-att-disabled="!canNext" t-on-click="() => this.shift(1)"><i class="fa fa-chevron-right"/></button>
                                </div>
                            </div>
                        </div>

                        <!-- Cluster 2: Salesperson -->
                        <div class="id-sp__filter-cluster">
                            <span class="id-sp__cluster-label"><i class="fa fa-user"/> Salesperson (<t t-out="state.salesmanIds.length ? state.salesmanIds.length : 'Semua'"/>)</span>
                            <div class="id-sp__cluster-content id-sp__chips-wrap">
                                <t t-foreach="state.filters.salesmen" t-as="s" t-key="s.id">
                                    <button type="button" class="id-sp__chip"
                                            t-att-class="{'is-active': state.salesmanIds.includes(s.id)}"
                                            t-on-click="() => this.toggle('salesmanIds', s.id)" t-out="s.name"/>
                                </t>
                            </div>
                        </div>

                        <!-- Cluster 3: Channel -->
                        <div class="id-sp__filter-cluster">
                            <span class="id-sp__cluster-label"><i class="fa fa-sitemap"/> Channel Saluran (<t t-out="state.channelIds.length ? state.channelIds.length : 'Semua'"/>)</span>
                            <div class="id-sp__cluster-content id-sp__chips-wrap">
                                <t t-foreach="state.filters.channels" t-as="c" t-key="c.id">
                                    <button type="button" class="id-sp__chip" t-att-title="c.name"
                                            t-att-class="{'is-active': state.channelIds.includes(c.id)}"
                                            t-on-click="() => this.toggle('channelIds', c.id)" t-out="c.code"/>
                                </t>
                            </div>
                        </div>

                        <!-- Cluster 4: Actions -->
                        <div class="id-sp__filter-actions">
                            <button type="button" class="id-sp__btn-reset" t-on-click="reset">
                                <i class="fa fa-undo"/> Reset
                            </button>
                        </div>
                    </div></details>
                </header>

                <div t-if="state.error" class="id-sp__alert" role="alert" t-out="state.error"/>
                <div t-if="state.loading and !state.data" class="id-sp__empty"><i class="fa fa-circle-o-notch fa-spin"/> Memuat data produktivitas…</div>

                <t t-if="state.data">
                    <p class="text-muted small mb-0">Nilai SO dalam <t t-out="state.data.currency"/> · kurs tanggal SO (WITA). Check-in hanya command server accepted; foto tersendiri bukan kunjungan.</p>
                    <div t-if="!state.data.total.orders" class="id-sp__notice">
                        <i class="fa fa-info-circle"/> Tidak ada pesanan penjualan (SO) tervalidasi pada periode dan filter terpilih.
                    </div>

                    <!-- BABAK 1: COMMERCIAL & FIELD PULSE -->
                    <section class="id-sp__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-sp__head">
                            <h2 class="id-sp__section-title"><i class="fa fa-line-chart"/> Ringkasan Kinerja Penjualan (Commercial Engine)</h2>
                            <span class="id-sp__section-sub">Pendapatan kotor, kontrol diskon nota, omzet bersih (DPP), dan realisasi pengiriman.</span>
                        </div>
                        <div class="id-sp__cards">
                            <t t-foreach="salesCards" t-as="card" t-key="card.key">
                                <button type="button" class="id-sp__card" t-on-click="card.action">
                                    <div class="id-sp__card-header">
                                        <span class="id-sp__card-title" t-out="card.title"/>
                                        <span class="id-sp__micro-badge" t-att-class="'is-' + card.tone">
                                            <i t-att-class="'fa ' + card.icon"/>
                                        </span>
                                    </div>
                                    <div class="id-sp__card-body">
                                        <span class="id-sp__card-value" t-out="card.value"/>
                                        <span t-if="card.delta.text" class="id-sp__pill-delta" t-att-class="card.delta.cls">
                                            <t t-out="card.delta.text"/>
                                        </span>
                                    </div>
                                    <div class="id-sp__card-footer">
                                        <span class="id-sp__card-meta" t-out="card.meta"/>
                                    </div>
                                </button>
                            </t>
                        </div>
                    </section>
                    <section class="id-sp__section" t-if="state.data.outlet_activity">
                        <h2 class="id-sp__section-title">Aktivitas outlet &amp; target segmen SO</h2>
                        <p class="id-sp__note">Outlet = company + partner SO. Masuk/keluar membandingkan dua periode ini, bukan pelanggan baru/hilang permanen.</p>
                        <div class="id-sp__cards">
                            <div class="id-sp__card"><span class="id-sp__card-title">Outlet dengan SO</span><strong class="id-sp__card-value" t-out="int(state.data.outlet_activity.current)"/></div>
                            <div class="id-sp__card"><span class="id-sp__card-title">Berulang</span><strong class="id-sp__card-value" t-out="int(state.data.outlet_activity.retained)"/></div>
                            <div class="id-sp__card"><span class="id-sp__card-title">Masuk periode ini</span><strong class="id-sp__card-value" t-out="int(state.data.outlet_activity.entered)"/></div>
                            <div class="id-sp__card"><span class="id-sp__card-title">Tidak berulang</span><strong class="id-sp__card-value" t-out="int(state.data.outlet_activity.exited)"/></div>
                        </div>
                        <p class="id-sp__note">Target = SO bersih, bukan realisasi faktur. Target lintas dimensi tidak dijumlahkan; perbandingan disembunyikan bila filter hanya mencakup sebagian segmen.</p>
                        <div class="id-sp__table-wrap" tabindex="0" role="region" aria-label="Target segmen SO" t-if="state.data.segment_targets.length">
                            <table class="id-sp__table"><thead><tr><th>Segmen</th><th>Company</th><th>Dimensi</th><th class="num">Target</th><th class="num">SO bersih</th><th class="num">Capaian</th></tr></thead>
                                <tbody><tr t-foreach="state.data.segment_targets" t-as="target" t-key="target.id">
                                    <td t-out="target.segment"/><td t-out="target.company"/><td t-out="targetDimension(target.dimension)"/>
                                    <td class="num" t-out="money(target.target)"/><td class="num" t-out="money(target.actual)"/>
                                    <td class="num"><t t-out="pct(target.achievement)"/><small t-if="!target.scope_complete">Filter parsial</small></td>
                                </tr></tbody>
                            </table>
                        </div>
                        <p t-else="" class="id-sp__note">Belum ada target segmen yang dapat dibaca untuk rentang tanggal ini.</p>
                    </section>



<section class="id-sp__section" t-if="state.data.order_margin" aria-label="Traceable order margin">
    <h2 class="id-sp__section-title">Traceable closed-order margin</h2>
    <p class="text-muted small">Order-date cohort; current posted invoice revenue in company currency versus linked delivery cost journals. Only fully delivered and invoiced stock orders without returns, credits, service lines or ambiguous shared journals qualify. No standard-cost fallback. Delivery expenses and fleet maintenance are not included.</p>
    <t t-if="state.data.order_margin.available">
        <p>Covered orders: <t t-out="state.data.order_margin.covered"/> / <t t-out="state.data.order_margin.count"/> · Covered margin: <strong t-out="money(state.data.order_margin.margin)"/></p>
        <div class="table-responsive" tabindex="0" role="region" aria-label="Order margin sources"><table class="table table-sm">
            <thead><tr><th>Order</th><th>Posted revenue</th><th>Delivery COGS</th><th>Margin</th><th>Coverage</th></tr></thead><tbody>
                <tr t-foreach="state.data.order_margin.rows" t-as="m" t-key="m.id"><td><button t-if="m.available" class="btn btn-sm btn-link" t-on-click="() => this.openMarginSources(m)" t-out="m.name"/><span t-else="" t-out="m.name"/></td><td t-out="money(m.revenue)"/><td t-out="money(m.cost)"/><td t-out="money(m.margin)"/><td><t t-if="m.available">Linked posted sources</t><t t-else="" t-out="marginReason(m.reason)"/></td></tr>
            </tbody></table></div>
        <p class="text-muted small">Rows shown: <t t-out="state.data.order_margin.rows.length"/> / <t t-out="state.data.order_margin.rows_total"/>. Totals cover all qualifying orders in the selected cohort.</p>
    </t><p t-else="" class="text-muted">Available to accounting roles</p>
</section>

                    <!-- BABAK 1B: FIELD PRODUCTIVITY PULSE -->
                    <section class="id-sp__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-sp__head">
                            <h2 class="id-sp__section-title"><i class="fa fa-map-marker"/> Produktivitas Lapangan &amp; Kualitas Pesanan</h2>
                            <span class="id-sp__section-sub">PJP dan EC memakai check-in accepted yang sesuai assignment. EC memerlukan SO terkonfirmasi setelah check-in pada outlet/company/hari WITA yang sama.</span>
                        </div>
                        <div class="id-sp__cards id-sp__cards--5">
                            <t t-foreach="fieldCards" t-as="card" t-key="card.key">
                                <div class="id-sp__card">
                                    <div class="id-sp__card-header">
                                        <span class="id-sp__card-title" t-out="card.title"/>
                                        <span class="id-sp__micro-badge" t-att-class="'is-' + card.tone">
                                            <i t-att-class="'fa ' + card.icon"/>
                                        </span>
                                    </div>
                                    <div class="id-sp__card-body">
                                        <span class="id-sp__card-value" t-att-class="card.cls" t-out="card.value"/>
                                        <span t-if="card.delta.text" class="id-sp__pill-delta" t-att-class="card.delta.cls">
                                            <t t-out="card.delta.text"/>
                                        </span>
                                    </div>
                                    <div class="id-sp__card-footer">
                                        <span class="id-sp__card-meta" t-out="card.meta"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <p t-if="pjp.available and pjpScopeOwn" class="id-sp__note">
                            * Data PJP mencakup rute kunjungan Anda sendiri sesuai hak akses role salesman.
                        </p>
                    </section>

                    <p class="id-sp__note" t-if="state.data.total.pjp.proof_completed !== undefined">Bukti foto/GPS sesuai assignment: <strong t-out="int(state.data.total.pjp.proof_completed)"/> dari <t t-out="int(state.data.total.pjp.planned)"/> slot · bukan jumlah check-in. Scope PJP: <t t-out="state.data.pjp_status.scope"/>.</p>
                    <!-- BABAK 2: VARIANCE DIAGNOSTICS & DRIVERS -->
                    <section class="id-sp__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-sp__head">
                            <h2 class="id-sp__section-title"><i class="fa fa-bar-chart"/> Analisis Distribusi &amp; Penggerak Pendapatan (Drivers)</h2>
                            <span class="id-sp__section-sub">Tren harian dan komparasi produktivitas antar-salesman serta saluran distribusi.</span>
                        </div>
                        <div class="id-sp__charts">
                            <div class="id-sp__chart-card id-sp__chart-card--wide">
                                <h3 class="id-sp__section-title"><i class="fa fa-line-chart"/> Tren Pendapatan Bersih Harian (DPP)</h3>
                                <svg class="id-sp__trend" viewBox="0 0 100 100" preserveAspectRatio="none" role="img"
                                     aria-label="Net revenue per day">
                                    <line x1="0" y1="10" x2="100" y2="10" class="id-sp__grid"/>
                                    <line x1="0" y1="55" x2="100" y2="55" class="id-sp__grid"/>
                                    <line x1="0" y1="100" x2="100" y2="100" class="id-sp__grid"/>
                                    <t t-foreach="trendBars" t-as="bar" t-key="bar.date">
                                        <rect t-att-x="bar.x" t-att-y="bar.y" t-att-width="bar.w" t-att-height="bar.h"
                                              class="id-sp__rect">
                                            <title><t t-out="bar.date"/> · <t t-out="money(bar.net)"/> · <t t-out="bar.orders"/> orders</title>
                                        </rect>
                                    </t>
                                </svg>
                                <div class="id-sp__axis">
                                    <span t-out="state.data.trend[0]?.date"/>
                                    <span>Puncak Harian: <t t-out="moneyShort(trendMax)"/></span>
                                    <span t-out="state.data.trend[state.data.trend.length - 1]?.date"/>
                                </div>
                            </div>
                            <div class="id-sp__chart-card">
                                <h3 class="id-sp__section-title"><i class="fa fa-user"/> Omzet Bersih per Salesperson</h3>
                                <t t-foreach="salesmanBars" t-as="bar" t-key="bar.id">
                                    <div class="id-sp__hbar">
                                        <span class="id-sp__hbar-label" t-out="bar.name"/>
                                        <span class="id-sp__hbar-track"><span class="id-sp__hbar-fill is-blue" t-att-style="'width:' + bar.width + '%'"/></span>
                                        <span class="id-sp__hbar-value" t-out="moneyShort(bar.net)"/>
                                    </div>
                                </t>
                                <div t-if="!salesmanBars.length" class="id-sp__empty">Tidak ada data salesman</div>
                            </div>
                            <div class="id-sp__chart-card">
                                <h3 class="id-sp__section-title"><i class="fa fa-sitemap"/> Omzet Bersih per Saluran (Channel)</h3>
                                <t t-foreach="channelBars" t-as="bar" t-key="bar.id">
                                    <div class="id-sp__hbar">
                                        <span class="id-sp__hbar-label" t-out="bar.name"/>
                                        <span class="id-sp__hbar-track"><span class="id-sp__hbar-fill is-emerald" t-att-style="'width:' + bar.width + '%'"/></span>
                                        <span class="id-sp__hbar-value" t-out="moneyShort(bar.net)"/>
                                    </div>
                                </t>
                                <div t-if="!channelBars.length" class="id-sp__empty">Tidak ada data channel</div>
                            </div>
                            <div class="id-sp__chart-card">
                                <h3 class="id-sp__section-title"><i class="fa fa-list-ol"/> Lines per Order (LPO) vs Target</h3>
                                <t t-foreach="lpoBars" t-as="bar" t-key="bar.id">
                                    <div class="id-sp__hbar">
                                        <span class="id-sp__hbar-label" t-out="bar.name"/>
                                        <span class="id-sp__hbar-track">
                                            <span class="id-sp__hbar-fill" t-att-class="bar.ok ? 'is-emerald' : 'is-amber'" t-att-style="'width:' + bar.width + '%'"/>
                                            <span class="id-sp__target" t-att-style="'left:' + lpoTargetPos + '%'"/>
                                        </span>
                                        <span class="id-sp__hbar-value" t-out="num1(bar.lpo)"/>
                                    </div>
                                </t>
                                <p class="id-sp__note">Garis tegak hitam = target minimal ≥ <t t-out="num1(state.data.lpo_target)"/> SKU per nota pesanan.</p>
                            </div>
                            <div class="id-sp__chart-card">
                                <h3 class="id-sp__section-title"><i class="fa fa-file-text-o"/> Tingkat Pemenuhan Faktur (Fulfillment)</h3>
                                <t t-foreach="fulfillmentBars" t-as="bar" t-key="bar.id">
                                    <div class="id-sp__hbar">
                                        <span class="id-sp__hbar-label" t-out="bar.name"/>
                                        <span class="id-sp__hbar-track"><span class="id-sp__hbar-fill is-navy" t-att-style="'width:' + bar.width + '%'"/></span>
                                        <span class="id-sp__hbar-value" t-out="pct(bar.value)"/>
                                    </div>
                                </t>
                                <div t-if="!fulfillmentBars.length" class="id-sp__empty">Tidak ada data fulfillment</div>
                            </div>
                        </div>
                    </section>

                    <!-- BABAK 3: FIELD ACTION & PRODUCTIVITY TABLE -->
                    <section class="id-sp__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-sp__head">
                            <h2 class="id-sp__section-title"><i class="fa fa-table"/> Matriks Rincian Produktivitas</h2>
                            <div class="id-sp__seg" role="group">
                                <button type="button" class="id-sp__seg-btn"
                                        t-att-class="{'is-active': state.dimension === 'salesman'}"
                                        t-on-click="() => state.dimension = 'salesman'">Per Salesman</button>
                                <button type="button" class="id-sp__seg-btn"
                                        t-att-class="{'is-active': state.dimension === 'channel'}"
                                        t-on-click="() => state.dimension = 'channel'">Per Saluran (Channel)</button>
                            </div>
                        </div>
                        <div class="id-sp__table-wrap" tabindex="0" role="region" aria-label="Tabel rincian dashboard">
                            <table class="id-sp__table">
                                <thead>
                                    <tr>
                                        <th t-out="state.dimension === 'salesman' ? 'Salesperson' : 'Saluran (Channel)'"/>
                                        <th class="num">Order</th>
                                        <th class="num">Gross</th>
                                        <th class="num">Diskon</th>
                                        <th class="num">Net DPP</th>
                                        <th class="num">DO</th>
                                        <th class="num">PJP Compliance</th>
                                        <th class="num">EC Ratio</th>
                                        <th class="num">LPO</th>
                                        <th class="num">SKU</th>
                                        <th class="num">Fulfillment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="rows" t-as="row" t-key="row.id" t-on-click="() => this.openRow(row)">
                                        <td class="name" t-out="row.name"/>
                                        <td class="num" t-out="int(row.orders)"/>
                                        <td class="num" t-out="moneyShort(row.gross)"/>
                                        <td class="num" t-out="moneyShort(row.discount)"/>
                                        <td class="num" t-out="moneyShort(row.net)"/>
                                        <td class="num" t-out="int(row.do_count)"/>
                                        <td class="num" t-out="row.pjp ? pct(row.pjp.compliance) : '–'"/>
                                        <td class="num" t-out="row.pjp ? pct(row.pjp.ec_ratio) : '–'"/>
                                        <td class="num">
                                            <span class="id-sp__pill"
                                                  t-att-class="row.lpo_ok === null ? '' : (row.lpo_ok ? 'is-ok' : 'is-low')"
                                                  t-out="num1(row.lpo)"/>
                                        </td>
                                        <td class="num" t-out="int(row.sku_sold)"/>
                                        <td class="num" t-out="pct(row.fulfillment)"/>
                                    </tr>
                                    <tr t-if="!rows.length">
                                        <td colspan="11" class="id-sp__empty">Tidak ada data untuk periode dan filter terpilih.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <!-- BABAK 3B: SKU PENETRATION MATRIX -->
                    <section class="id-sp__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-sp__head">
                            <h2 class="id-sp__section-title"><i class="fa fa-cubes"/> Penetrasi SKU FMCG (Penyebaran Brand di Saluran)</h2>
                            <div class="id-sp__seg" role="group">
                                <button type="button" class="id-sp__seg-btn"
                                        t-att-class="{'is-active': state.penKind === 'principal'}"
                                        t-on-click="() => state.penKind = 'principal'">Per Principal</button>
                                <button type="button" class="id-sp__seg-btn"
                                        t-att-class="{'is-active': state.penKind === 'brand'}"
                                        t-on-click="() => state.penKind = 'brand'">Per Brand</button>
                            </div>
                        </div>
                        <div class="id-sp__table-wrap" tabindex="0" role="region" aria-label="Tabel rincian dashboard">
                            <table class="id-sp__table" t-if="penetration.length">
                                <thead>
                                    <tr>
                                        <th t-out="state.penKind === 'principal' ? 'Principal' : 'Brand'"/>
                                        <th class="num">Katalog SKU</th>
                                        <th class="num" t-foreach="rows" t-as="row" t-key="row.id" t-out="row.name"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="penetration" t-as="item" t-key="item.id">
                                        <td class="name" t-out="item.name"/>
                                        <td class="num" t-out="int(item.catalog)"/>
                                        <td t-foreach="rows" t-as="row" t-key="row.id" class="num"
                                            t-att-class="heat(penCell(item, row).penetration)">
                                            <span><t t-out="int(penCell(item, row).sold)"/> SKU</span>
                                            <small class="d-block" t-out="pct(penCell(item, row).penetration)"/>
                                            <small t-if="penCell(item, row).outside_catalog" class="d-block text-warning"><t t-out="int(penCell(item, row).outside_catalog)"/> di luar katalog aktif</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div t-else="" class="id-sp__empty">Tidak ada data SKU terjual untuk filter ini.</div>
                        </div>
                        <p class="id-sp__note">Persentase = SKU terjual yang masih eligible / katalog aktif saat query yang dapat dibaca akun (bukan snapshot historis); kelompok tanpa penjualan tetap tampil. SKU arsip/non-saleable ditandai terpisah.</p>
                    </section>
                </t>
            </div>
        </div>
    </t>
</templates>
