<odoo>
    <record id="segment_company_rule" model="ir.rule">
        <field name="name">Segment targets: selected companies</field>
        <field name="model_id" ref="model_id_sales_segment_target"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="segment_own_rule" model="ir.rule">
        <field name="name">Salespeople read their assigned targets</field>
        <field name="model_id" ref="model_id_sales_segment_target"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('salesman_id', '=', user.id)]</field>
    </record>
    <record id="segment_manager_rule" model="ir.rule">
        <field name="name">Managers administer segment targets</field>
        <field name="model_id" ref="model_id_sales_segment_target"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
