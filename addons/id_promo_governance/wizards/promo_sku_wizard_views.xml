<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_id_promo_sku_wizard_form" model="ir.ui.view">
        <field name="name">id.promo.sku.wizard.form</field>
        <field name="model">id.promo.sku.wizard</field>
        <field name="arch" type="xml">
            <form string="Pilih Target SKU Promosi">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Gunakan filter berjenjang di bawah (Prinsipal, Kategori, Brand, Sub-Brand) untuk memilih daftar SKU yang berhak mendapatkan diskon promosi secara akurat.
                    </div>
                    <group>
                        <group string="Filter Hirarki Produk">
                            <field name="program_id" readonly="1"/>
                            <field name="principal_id" options="{'no_create': True}"/>
                            <field name="brand_id" options="{'no_create': True}"/>
                            <field name="sub_brand_id" options="{'no_create': True}"/>
                            <field name="categ_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Statistik Pemilihan">
                            <field name="selected_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daftar SKU Terpilih">
                            <field name="product_ids" widget="many2many">
                                <list>
                                    <field name="default_code"/>
                                    <field name="name"/>
                                    <field name="principal_id"/>
                                    <field name="brand_id"/>
                                    <field name="lst_price" string="Harga Jual Base"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_apply_skus_to_promo" string="Terapkan ke Aturan Promo" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
