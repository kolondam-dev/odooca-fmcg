<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Loyalty Program Form View for FMCG Governance -->
    <record id="view_loyalty_program_form_fmcg_inherit" model="ir.ui.view">
        <field name="name">loyalty.program.form.fmcg.inherit</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <button name="action_submit_approval" string="Ajukan Approval" type="object" class="btn-primary" invisible="governance_state not in ['draft']"/>
                    <button name="action_approve" string="Setujui (Approve)" type="object" class="btn-success" invisible="governance_state not in ['pending']" groups="sales_team.group_sale_manager"/>
                    <button name="action_activate" string="Aktifkan Program" type="object" class="btn-primary" invisible="governance_state not in ['approved']"/>
                    <button name="action_reject" string="Tolak Promo" type="object" class="btn-danger" invisible="governance_state not in ['pending']" groups="sales_team.group_sale_manager"/>
                    <button name="action_close" string="Tutup / Selesai" type="object" invisible="governance_state not in ['active']"/>
                    <button name="action_reset_draft" string="Kembalikan ke Draft" type="object" invisible="governance_state not in ['rejected', 'closed']"/>
                    <button name="action_open_sku_wizard" string="Wizard Target SKU" type="object" class="btn-secondary" icon="fa-filter"/>
                    <field name="governance_state" widget="statusbar" statusbar_visible="draft,pending,approved,active,closed"/>
                </header>
            </sheet>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-money">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="total_claimable_amount" widget="monetary"/></span>
                        <span class="o_stat_text">Klaim Tagihan</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Tata Kelola &amp; Kontrak Prinsipal" name="fmcg_governance_page">
                        <group>
                            <group string="Perjanjian Dagang &amp; Anggaran">
                                <field name="mou_number"/>
                                <field name="doc_date"/>
                                <field name="principal_id" options="{'no_create': True}"/>
                                <field name="budget_source"/>
                            </group>
                            <group string="Akun Finansial &amp; Analitik">
                                <field name="claim_account_id" options="{'no_create': True}"/>
                                <field name="analytic_account_id" options="{'no_create': True}"/>
                                <field name="order_line_count"/>
                            </group>
                        </group>
                        <group string="Bukti Persetujuan Prinsipal">
                            <group>
                                <field name="principal_approver_name"/>
                                <field name="principal_approver_title"/>
                            </group>
                            <group>
                                <field name="mou_attachment" filename="mou_filename"/>
                                <field name="mou_filename" invisible="1"/>
                            </group>
                        </group>
                        <group string="Audit Approval Internal" invisible="governance_state in ['draft']">
                            <group>
                                <field name="approver_id"/>
                                <field name="approval_date"/>
                            </group>
                            <group>
                                <field name="rejection_notes" invisible="governance_state != 'rejected'"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Inherit Loyalty Program Tree View -->
    <record id="view_loyalty_program_tree_fmcg_inherit" model="ir.ui.view">
        <field name="name">loyalty.program.tree.fmcg.inherit</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="mou_number" optional="show"/>
                <field name="principal_id" optional="show"/>
                <field name="budget_source" optional="show"/>
                <field name="governance_state" widget="badge" 
                       decoration-success="governance_state in ['active', 'approved']" 
                       decoration-warning="governance_state == 'pending'" 
                       decoration-danger="governance_state == 'rejected'" 
                       decoration-info="governance_state == 'draft'" 
                       optional="show"/>
                <field name="total_claimable_amount" widget="monetary" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
