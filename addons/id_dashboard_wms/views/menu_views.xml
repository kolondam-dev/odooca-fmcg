<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Executive WMS OWL Client Action -->
    <record id="action_wms_dashboard" model="ir.actions.client">
        <field name="name">Warehouse &amp; Logistics Dashboard</field>
        <field name="tag">id_dashboard_wms.wms_dashboard</field>
    </record>

    <!-- Group Dashboards under Odoo Root Dashboards -->
    <menuitem id="menu_root_dash_wms"
              name="Warehouse &amp; Logistics"
              parent="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"
              action="action_wms_dashboard"
              sequence="30"
              groups="stock.group_stock_user,sales_team.group_sale_salesman"/>

    <!-- Group Dashboards under FMCG Distribution -->
    <menuitem id="menu_fmcg_dash_wms"
              name="Warehouse &amp; Logistics"
              parent="id_base.menu_fmcg_dashboard"
              action="action_wms_dashboard"
              sequence="30"
              groups="stock.group_stock_user,sales_team.group_sale_salesman"/>

    <!-- Warehouse & Logistics Menu Section in FMCG Distribution -->
    <menuitem id="menu_fmcg_wms"
              name="Warehouse &amp; Logistics"
              parent="id_base.menu_fmcg_root"
              sequence="30"/>

    <!-- Submenu 1: Executive Interactive Dashboard -->
    <menuitem id="menu_wms_executive_dashboard"
              name="Executive Dashboard"
              parent="menu_fmcg_wms"
              action="action_wms_dashboard"
              sequence="1"/>

    <!-- Submenus 2+: Drilldown & Analytical Data (Preserved Existing Views) -->
    <menuitem id="menu_wms_stock_category"
              name="Stock by FMCG Category"
              parent="menu_fmcg_wms"
              action="action_id_wms_stock_category"
              sequence="10"/>

    <menuitem id="menu_wms_expiry"
              name="FEFO Expiry Monitoring"
              parent="menu_fmcg_wms"
              action="action_id_wms_expiry"
              sequence="20"/>

    <menuitem id="menu_wms_delivery"
              name="Delivery Fulfillment"
              parent="menu_fmcg_wms"
              action="action_id_wms_delivery"
              sequence="30"/>

    <menuitem id="menu_wms_delivery_summary"
              name="Delivery Rate per Period"
              parent="menu_fmcg_wms"
              action="action_id_wms_delivery_summary"
              sequence="40"/>

    <menuitem id="menu_wms_reject"
              name="Rejection Breakdown"
              parent="menu_fmcg_wms"
              action="action_id_wms_reject"
              sequence="50"/>

    <menuitem id="menu_wms_fleet_cost"
              name="Delivery Cost Ratio"
              parent="menu_fmcg_wms"
              action="action_id_wms_fleet_cost"
              sequence="60"/>

    <menuitem id="menu_delivery_trip_cost"
              name="Delivery Trip Costs"
              parent="menu_fmcg_wms"
              action="action_id_delivery_trip_cost"
              sequence="90"
              groups="base.group_system"/>
</odoo>
