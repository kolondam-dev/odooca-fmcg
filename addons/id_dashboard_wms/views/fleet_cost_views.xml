<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trip cost input -->
    <record id="view_id_delivery_trip_cost_list" model="ir.ui.view">
        <field name="name">id.delivery.trip.cost.list</field>
        <field name="model">id.delivery.trip.cost</field>
        <field name="arch" type="xml">
            <list string="Delivery Trip Costs">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="fuel_cost" sum="Fuel"/>
                <field name="helper_cost" sum="Helper"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="note" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_id_delivery_trip_cost_form" model="ir.ui.view">
        <field name="name">id.delivery.trip.cost.form</field>
        <field name="model">id.delivery.trip.cost</field>
        <field name="arch" type="xml">
            <form string="Delivery Trip Cost">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group>
                            <field name="fuel_cost"/>
                            <field name="helper_cost"/>
                            <field name="total_cost"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Route, driver, or receipt reference"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_id_delivery_trip_cost_search" model="ir.ui.view">
        <field name="name">id.delivery.trip.cost.search</field>
        <field name="model">id.delivery.trip.cost</field>
        <field name="arch" type="xml">
            <search string="Delivery Trip Costs">
                <field name="vehicle_id"/>
                <field name="note"/>
                <filter name="filter_date" string="Trip Date" date="date"/>
                <group>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_id_delivery_trip_cost" model="ir.actions.act_window">
        <field name="name">Delivery Trip Costs</field>
        <field name="res_model">id.delivery.trip.cost</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record fuel and helper cost</p>
            <p>Enter the fuel and helper cost of each trip. The cost ratio dashboard compares
               the monthly total with the value delivered by the same vehicle.</p>
        </field>
    </record>

    <!-- Cost ratio per vehicle -->
    <record id="view_id_wms_fleet_cost_list" model="ir.ui.view">
        <field name="name">id.wms.fleet.cost.list</field>
        <field name="model">id.wms.fleet.cost</field>
        <field name="arch" type="xml">
            <list string="Delivery Cost Ratio per Vehicle" create="0" edit="0" delete="0">
                <field name="period_month"/>
                <field name="vehicle_id"/>
                <field name="fuel_cost" sum="Fuel"/>
                <field name="helper_cost" sum="Helper"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="delivered_value" sum="Delivered Value"/>
                <field name="cost_ratio_percent"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_id_wms_fleet_cost_graph" model="ir.ui.view">
        <field name="name">id.wms.fleet.cost.graph</field>
        <field name="model">id.wms.fleet.cost</field>
        <field name="arch" type="xml">
            <graph string="Delivery Cost Ratio per Vehicle" type="bar">
                <field name="vehicle_id"/>
                <field name="cost_ratio_percent" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_id_wms_fleet_cost_pivot" model="ir.ui.view">
        <field name="name">id.wms.fleet.cost.pivot</field>
        <field name="model">id.wms.fleet.cost</field>
        <field name="arch" type="xml">
            <pivot string="Delivery Cost Ratio per Vehicle">
                <field name="vehicle_id" type="row"/>
                <field name="period_month" type="col"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_id_wms_fleet_cost_search" model="ir.ui.view">
        <field name="name">id.wms.fleet.cost.search</field>
        <field name="model">id.wms.fleet.cost</field>
        <field name="arch" type="xml">
            <search string="Delivery Cost Ratio per Vehicle">
                <field name="vehicle_id"/>
                <group>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'period_month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_id_wms_fleet_cost" model="ir.actions.act_window">
        <field name="name">Delivery Cost Ratio</field>
        <field name="res_model">id.wms.fleet.cost</field>
        <field name="view_mode">graph,list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No trip cost recorded</p>
            <p>The ratio compares fuel and helper cost with the value delivered by the same
               vehicle in the month. Assign a delivery vehicle on the transfer to link them.</p>
        </field>
    </record>
</odoo>
