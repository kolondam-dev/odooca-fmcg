<odoo>
    <record id="view_asset_warehouse_list" model="ir.ui.view"><field name="name">asset.warehouse.list</field><field name="model">stock.warehouse</field><field name="arch" type="xml"><list editable="bottom" create="false" delete="false"><field name="name" readonly="1"/><field name="company_id" readonly="1"/><field name="lot_stock_id" readonly="1"/><field name="usable_volume_cbm"/><field name="capacity_basis"/></list></field></record>
    <record id="action_asset_warehouses" model="ir.actions.act_window"><field name="name">Usable Storage Capacity</field><field name="res_model">stock.warehouse</field><field name="view_mode">list,form</field><field name="view_id" ref="view_asset_warehouse_list"/></record>
    <record id="view_asset_trip_list" model="ir.ui.view"><field name="name">asset.trip.list</field><field name="model">id.asset.trip</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="vehicle_id"/><field name="departed_at"/><field name="state"/><field name="odometer_start_km"/><field name="odometer_end_km"/></list></field></record>
    <record id="view_asset_trip_form" model="ir.ui.view"><field name="name">asset.trip.form</field><field name="model">id.asset.trip</field><field name="arch" type="xml"><form>
        <header><button name="action_depart" type="object" groups="stock.group_stock_manager,base.group_system" string="Record Departure" class="oe_highlight" invisible="state != 'draft'"/><button name="action_close" type="object" groups="stock.group_stock_manager,base.group_system" string="Close Trip" class="oe_highlight" invisible="state != 'departed'"/><field name="state" widget="statusbar"/></header>
        <sheet><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'"/><field name="vehicle_id" readonly="state != 'draft'" domain="[('company_id', '=', company_id)]"/><field name="picking_ids" widget="many2many_tags" readonly="state != 'draft'" domain="[('company_id', '=', company_id), ('fmcg_vehicle_id', '=', vehicle_id), ('state', '=', 'assigned')]"/><field name="departed_at"/><field name="closed_at"/><field name="departed_by"/><field name="closed_by"/><field name="odometer_start_km" readonly="state != 'draft'"/><field name="odometer_end_km" readonly="state == 'closed'"/><field name="currency_id" invisible="1"/></group>
        <group string="Recorded Direct Trip Costs (excludes maintenance)"><field name="fuel_cost" readonly="state == 'closed'"/><field name="helper_cost" readonly="state == 'closed'"/><field name="order_processing_cost" readonly="state == 'closed'"/><field name="other_delivery_cost" readonly="state == 'closed'"/><field name="cost_basis" readonly="state == 'closed'"/></group><field name="load_summary" readonly="1"/><field name="note" readonly="state == 'closed'"/></sheet>
    </form></field></record>
    <record id="action_asset_trips" model="ir.actions.act_window"><field name="name">Load and Trip Records</field><field name="res_model">id.asset.trip</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_asset_trips" name="Load and Trip Records" parent="menu_fmcg_wms" action="action_asset_trips" sequence="91"/>
    <menuitem id="menu_asset_capacity" name="Usable Storage Capacity" parent="menu_fmcg_wms" action="action_asset_warehouses" sequence="92" groups="stock.group_stock_manager"/>
</odoo>
