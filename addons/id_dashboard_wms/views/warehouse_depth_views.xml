<odoo>
    <record id="view_storage_master_list" model="ir.ui.view"><field name="name">fmcg.storage.master.list</field><field name="model">stock.location</field><field name="arch" type="xml"><list><field name="complete_name"/><field name="company_id"/><field name="usage"/><field name="fmcg_storage_kind"/><field name="fmcg_usable_cbm"/><field name="fmcg_pallet_slots"/><field name="storage_category_id"/><field name="fmcg_spatial_verified"/></list></field></record>
    <record id="view_storage_master_form" model="ir.ui.view"><field name="name">fmcg.storage.master.form</field><field name="model">stock.location</field><field name="arch" type="xml"><form><sheet>
        <group><field name="name"/><field name="location_id"/><field name="company_id"/><field name="usage"/><field name="fmcg_storage_kind"/><field name="storage_category_id"/></group>
        <group string="Usable Capacity"><field name="fmcg_usable_cbm"/><field name="fmcg_pallet_slots"/><field name="fmcg_capacity_source"/></group>
        <group string="Measured Warehouse Geometry"><group><field name="fmcg_length_m"/><field name="fmcg_width_m"/><field name="fmcg_height_m"/></group><group><field name="fmcg_frame"/><field name="fmcg_x_m"/><field name="fmcg_y_m"/><field name="fmcg_z_m"/><field name="fmcg_spatial_verified"/></group></group>
    </sheet></form></field></record>
    <record id="action_storage_master" model="ir.actions.act_window"><field name="name">Physical Storage Master</field><field name="res_model">stock.location</field><field name="view_mode">list,form</field><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_storage_master_list')}),(0,0,{'view_mode':'form','view_id':ref('view_storage_master_form')})]"/><field name="domain">[('usage','in',['internal','view'])]</field></record>
    <record id="view_pallet_types" model="ir.ui.view"><field name="name">fmcg.pallet.type.list</field><field name="model">stock.package.type</field><field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="is_fmcg_pallet"/></list></field></record>
    <record id="action_pallet_types" model="ir.actions.act_window"><field name="name">Physical Pallet Types</field><field name="res_model">stock.package.type</field><field name="view_mode">list,form</field><field name="view_id" ref="view_pallet_types"/></record>
    <record id="view_warehouse_stock_policy" model="ir.ui.view"><field name="name">fmcg.warehouse.stock.policy</field><field name="model">stock.warehouse</field><field name="arch" type="xml"><list editable="bottom" create="false" delete="false"><field name="name" readonly="1"/><field name="company_id" readonly="1"/><field name="slow_stock_days"/><field name="dead_stock_days"/></list></field></record>
    <record id="action_warehouse_stock_policy" model="ir.actions.act_window"><field name="name">Stock Observation Policy</field><field name="res_model">stock.warehouse</field><field name="view_mode">list</field><field name="view_id" ref="view_warehouse_stock_policy"/></record>
    <record id="view_warehouse_clock_list" model="ir.ui.view"><field name="name">warehouse.clock.list</field><field name="model">id.warehouse.clock</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="warehouse_id"/><field name="picking_id"/><field name="kind"/><field name="state"/><field name="started_at"/><field name="ended_at"/><field name="duration_minutes"/></list></field></record>
    <record id="view_warehouse_clock_form" model="ir.ui.view"><field name="name">warehouse.clock.form</field><field name="model">id.warehouse.clock</field><field name="arch" type="xml"><form><header>
        <button name="action_start" type="object" string="Start Operation Clock" class="oe_highlight" invisible="state != 'draft'"/>
        <button name="action_complete" type="object" string="Complete Operation Clock" class="oe_highlight" invisible="state != 'running'"/>
        <button name="action_cancel" type="object" string="Cancel Clock" invisible="state != 'running'"/><field name="state" widget="statusbar"/>
    </header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'"/><field name="picking_id" readonly="state != 'draft'" domain="[('company_id','=',company_id)]"/><field name="warehouse_id"/><field name="kind" readonly="state != 'draft'"/><field name="completion_picking_id" readonly="state in ('done','cancelled')" domain="[('company_id','=',company_id)]"/></group><group><field name="started_at"/><field name="started_by"/><field name="ended_at"/><field name="ended_by"/><field name="duration_minutes"/><field name="note" readonly="state in ('done','cancelled')"/></group></sheet></form></field></record>
    <record id="action_warehouse_clocks" model="ir.actions.act_window"><field name="name">Warehouse Operation Clocks</field><field name="res_model">id.warehouse.clock</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_warehouse_clocks" name="Warehouse Operation Clocks" parent="menu_fmcg_wms" action="action_warehouse_clocks" sequence="94"/>
    <menuitem id="menu_storage_master" name="Physical Storage Master" parent="menu_fmcg_wms" action="action_storage_master" sequence="95" groups="stock.group_stock_manager"/>
    <menuitem id="menu_pallet_types" name="Physical Pallet Types" parent="menu_fmcg_wms" action="action_pallet_types" sequence="96" groups="stock.group_stock_manager"/>
    <menuitem id="menu_warehouse_stock_policy" name="Stock Observation Policy" parent="menu_fmcg_wms" action="action_warehouse_stock_policy" sequence="97" groups="stock.group_stock_manager"/>
</odoo>
