<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="id_dashboard_wms.WmsDashboard">
        <div class="o_action id-wms id-dashboard-workspace">
            <div class="id-wms__sheet">
                <!-- Header & Unified Grouped Filter Bar -->
                <header class="id-wms__header">
                    <div class="id-wms__header-main">
                        <div class="id-wms__header-title-wrap">
                            <span class="id-wms__badge-dept"><i class="fa fa-truck"/> GUDANG &amp; PENGIRIMAN</span>
                            <h1 class="id-wms__title">Gudang &amp; Pengiriman</h1>
                            <span class="id-wms__subtitle">Monitoring ketahanan kadaluwarsa FEFO, pemenuhan pesanan pengiriman (DO), dan efisiensi armada.</span>
                        </div>
                        <div class="id-wms__header-quick">
                            <button type="button" class="id-wms__quick-btn" t-on-click="openExpiryMatrix">
                                <i class="fa fa-hourglass-half"/> FEFO Expiry
                            </button>
                            <button type="button" class="id-wms__quick-btn" t-on-click="openDeliveryFulfillment">
                                <i class="fa fa-check-square-o"/> Pemenuhan DO
                            </button>
                            <button type="button" class="id-wms__quick-btn" t-on-click="openRejectAnalysis">
                                <i class="fa fa-ban"/> Analisis Retur/Reject
                            </button>
                            <button type="button" class="id-wms__quick-btn" t-on-click="openFleetCostAnalysis">
                                <i class="fa fa-tachometer"/> Biaya Armada
                            </button>
                            <button type="button" class="id-wms__quick-btn" t-on-click="openStockCategories">
                                <i class="fa fa-cubes"/> Stok Kategori
                            </button>
                        </div>
                    </div>

                    <!-- Filter Bar Clusters -->
                    <details class="dashboard-filters"><summary>Filter · Kategori: <t t-out="state.fmcgCategory || 'Semua'"/> · Armada: <t t-out="state.filters.vehicles.find(v => v.id === state.vehicleId)?.name || 'Semua'"/></summary><div class="id-wms__filter-bar">
                        <!-- Cluster 1: Category -->
                        <div class="id-wms__filter-cluster">
                            <span class="id-wms__cluster-label"><i class="fa fa-tags"/> Kategori Stok FMCG</span>
                            <div class="id-wms__cluster-content">
                                <select class="id-wms__select" t-att-value="state.fmcgCategory" t-on-change="onCategoryChange">
                                    <option value="">Semua Kategori</option>
                                    <t t-foreach="state.filters.categories" t-as="c" t-key="c.id">
                                        <option t-att-value="c.id" t-out="c.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <!-- Cluster 2: Vehicle -->
                        <div class="id-wms__filter-cluster">
                            <span class="id-wms__cluster-label"><i class="fa fa-car"/> Kendaraan Armada</span>
                            <div class="id-wms__cluster-content">
                                <select class="id-wms__select" t-att-value="state.vehicleId || ''" t-on-change="onVehicleChange">
                                    <option value="">Semua Armada</option>
                                    <t t-foreach="state.filters.vehicles" t-as="v" t-key="v.id">
                                        <option t-att-value="v.id" t-out="v.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="id-wms__filter-cluster"><label for="warehouse-detail-filter" class="id-wms__cluster-label">Warehouse detail</label><select id="warehouse-detail-filter" class="id-wms__select" t-att-value="state.warehouseId || ''" t-on-change="onWarehouseChange"><option value="">All warehouses</option><option t-foreach="state.filters.warehouses || []" t-as="wh" t-key="wh.id" t-att-value="wh.id" t-out="wh.name"/></select></div>
<!-- Cluster 3: Action -->
                        <div class="id-wms__filter-actions">
                            <button type="button" class="id-wms__btn-reset" t-on-click="reset">
                                <i class="fa fa-undo"/> Reset Filter
                            </button>
                        </div>
                    </div></details>
                <p class="dashboard-context">Stok terkini · pengiriman seluruh periode. Kategori untuk stok; armada untuk pengiriman dan biaya.</p>
                    <details class="small"><summary>Delivery cohort dates</summary>    <div class="d-flex flex-wrap gap-3 my-2">
        <label>Scheduled from<input type="date" class="form-control form-control-sm" data-field="cohortStart" t-att-value="state.cohortStart" t-on-change="onCohortDate"/></label>
        <label>Scheduled through<input type="date" class="form-control form-control-sm" data-field="cohortEnd" t-att-value="state.cohortEnd" t-on-change="onCohortDate"/></label>
    </div></details>
                </header>

                <div t-if="state.error" class="alert alert-danger mb-0" role="alert" t-out="state.error"/>
                <div t-if="state.loading and !state.data" class="id-wms__empty"><i class="fa fa-circle-o-notch fa-spin"/> Memuat data gudang &amp; logistik…</div>

                <t t-if="state.data">
                    <!-- BABAK 1: STORAGE & DISPATCH PULSE -->
                    <section class="id-wms__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-wms__head">
                            <h2 class="id-wms__section-title"><i class="fa fa-archive"/> Status Persediaan Gudang &amp; Tingkat Layanan Pengiriman</h2>
                            <span class="id-wms__section-sub">Valuasi stok aktif, deteksi dini kadaluwarsa FEFO, pemenuhan DO, dan rasio biaya armada logistik.</span>
                        </div>
                        <div class="id-wms__cards">
                            <button type="button" class="id-wms__card" t-on-click="openStockCategories">
                                <div class="id-wms__card-header">
                                    <span class="id-wms__card-title">Nilai Persediaan Gudang</span>
                                    <span class="id-wms__micro-badge is-navy"><i class="fa fa-cubes"/></span>
                                </div>
                                <div class="id-wms__card-body">
                                    <span class="id-wms__card-value" t-out="moneyShort(state.data.kpi.total_stock_value)"/>
                                </div>
                                <div class="id-wms__card-footer">
                                    <t t-out="int(state.data.kpi.total_stock_qty)"/> unit fisik aktif di gudang
                                </div>
                            </button>
                            <button type="button" class="id-wms__card" t-on-click="openExpiryMatrix">
                                <div class="id-wms__card-header">
                                    <span class="id-wms__card-title">Stok Kritis FEFO (&lt;30 Hari)</span>
                                    <span class="id-wms__micro-badge is-red"><i class="fa fa-exclamation-triangle"/></span>
                                </div>
                                <div class="id-wms__card-body">
                                    <span class="id-wms__card-value is-danger" t-out="moneyShort(state.data.kpi.critical_stock_value)"/>
                                </div>
                                <div class="id-wms__card-footer">
                                    <t t-out="int(state.data.kpi.critical_stock_count)"/> batch/lot wajib retur vendor
                                </div>
                            </button>
                            <button type="button" class="id-wms__card" t-on-click="openDeliveryFulfillment">
                                <div class="id-wms__card-header">
                                    <span class="id-wms__card-title">Tingkat Pemenuhan DO</span>
                                    <span class="id-wms__micro-badge is-emerald"><i class="fa fa-check-circle-o"/></span>
                                </div>
                                <div class="id-wms__card-body">
                                    <span class="id-wms__card-value" t-out="pct(state.data.kpi.fulfillment_rate)"/>
                                </div>
                                <div class="id-wms__card-footer">
                                    <t t-out="int(state.data.kpi.delivered_count)"/> dari <t t-out="int(state.data.kpi.total_deliveries)"/> pesanan terkirim
                                </div>
                            </button>
                            <button type="button" class="id-wms__card" t-on-click="openFleetCostAnalysis">
                                <div class="id-wms__card-header">
                                    <span class="id-wms__card-title">Rasio Biaya Armada Logistik</span>
                                    <span class="id-wms__micro-badge is-amber"><i class="fa fa-money"/></span>
                                </div>
                                <div class="id-wms__card-body">
                                    <span class="id-wms__card-value is-warn" t-out="pct(state.data.kpi.fleet_cost_ratio)"/>
                                </div>
                                <div class="id-wms__card-footer">
                                    Total Biaya: <t t-out="moneyShort(state.data.kpi.total_fleet_cost)"/>
                                </div>
                            </button>
                        </div>
                    </section>
                    <section class="dashboard-priorities" aria-label="Prioritas gudang dan pengiriman">
                        <h2>Prioritas operasional</h2>
                        <ul>
                            <li><strong><t t-out="int(state.data.kpi.critical_stock_count)"/> lot expiry kritis (&lt;30 hari)</strong>
                                <span t-out="moneyShort(state.data.kpi.critical_stock_value)"/>
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="openCriticalStock">Periksa lot</button>
                            </li>
                            <li><strong><t t-out="int(state.data.kpi.total_rejections)"/> pengiriman ditolak / dibatalkan</strong>
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="openRejectAnalysis">Periksa pengiriman</button>
                            </li>
                        </ul>
                    </section>


                    <!-- BABAK 2: FEFO HEALTH & DELIVERY OVERVIEW -->
                    <section class="id-wms__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-wms__head">
                            <h2 class="id-wms__section-title"><i class="fa fa-hourglass-start"/> Monitoring Ketahanan Stok FEFO (First-Expired, First-Out)</h2>
                            <span class="id-wms__section-sub">Klasifikasi stok berdasarkan umur simpan: Kritis (&lt;30h: Retur), Waspada (30-90h: Bundling), Aman (&gt;90h).</span>
                        </div>
                        <div class="id-wms__fefo-bar-wrap">
                            <t t-foreach="state.data.expiry_buckets" t-as="b" t-key="b.key">
                                <div t-attf-class="id-wms__fefo-bar-segment seg-#{b.key}"
                                     t-att-style="'width:' + b.share + '%'"
                                     t-att-title="b.label + ': ' + money(b.value) + ' (' + pct(b.share) + ')'"/>
                            </t>
                        </div>
                        <div class="id-wms__fefo-legend">
                            <t t-foreach="state.data.expiry_buckets" t-as="b" t-key="b.key">
                                <div class="id-wms__legend-item">
                                    <span t-attf-class="id-wms__legend-dot dot-#{b.key}"/>
                                    <span><t t-out="b.label"/>: <strong><t t-out="moneyShort(b.value)"/></strong> (<t t-out="pct(b.share)"/> · <t t-out="int(b.count)"/> lot)</span>
                                </div>
                            </t>
                        </div>
                    </section>

                    <!-- BABAK 2B: DELIVERY SUMMARY -->
                    <section class="id-wms__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-wms__head">
                            <h2 class="id-wms__section-title"><i class="fa fa-road"/> Ringkasan Operasional Pengiriman (Delivery Performance)</h2>
                            <span class="id-wms__section-sub">Nilai pesanan sukses terkirim, tingkat keterlambatan jadwal, dan jumlah retur/tolakan toko.</span>
                        </div>
                        <div class="id-wms__cards id-wms__cards--3">
                            <div class="id-wms__card">
                                <div class="id-wms__card-header">
                                    <span class="id-wms__card-title">Nilai DO Terkirim Sukses</span>
                                    <span class="id-wms__micro-badge is-blue"><i class="fa fa-truck"/></span>
                                </div>
                                <div class="id-wms__card-body">
                                    <span class="id-wms__card-value" t-out="moneyShort(state.data.kpi.delivered_value)"/>
                                </div>
                                <div class="id-wms__card-footer">
                                    <t t-out="int(state.data.kpi.delivered_count)"/> pengantaran sukses di outlet
                                </div>
                            </div>
                            <div class="id-wms__card">
                                <div class="id-wms__card-header">
                                    <span class="id-wms__card-title">Pengiriman Terlambat</span>
                                    <span class="id-wms__micro-badge is-amber"><i class="fa fa-clock-o"/></span>
                                </div>
                                <div class="id-wms__card-body">
                                    <span class="id-wms__card-value is-warn" t-out="int(state.data.kpi.late_count)"/>
                                </div>
                                <div class="id-wms__card-footer">
                                    Melewati jadwal komitmen pengantaran
                                </div>
                            </div>
                            <div class="id-wms__card">
                                <div class="id-wms__card-header">
                                    <span class="id-wms__card-title">Tolakan / Retur Pengantaran</span>
                                    <span class="id-wms__micro-badge is-red"><i class="fa fa-undo"/></span>
                                </div>
                                <div class="id-wms__card-body">
                                    <span class="id-wms__card-value is-danger" t-out="int(totalRejections)"/>
                                </div>
                                <div class="id-wms__card-footer">
                                    Tingkat Tolakan: <strong><t t-out="pct(state.data.kpi.rejection_rate)"/></strong>
                                </div>
                            </div>
                        </div>
                    </section>


<section class="id-wms__section" t-if="state.data.cohort" aria-label="Scheduled delivery cohort">
    <h2 class="id-wms__section-title">Scheduled delivery cohort</h2>
    <p class="text-muted small">Root outgoing DOs, including backorders and cancellations. Current scheduled date is the promise; H+1/H+2 use WITA calendar days after that date, not order acceptance. Only fully elapsed H+1/H+2 days enter the denominator. Category filter does not apply; vehicle follows the root DO.</p>

    <p class="small"><t t-out="state.data.cohort.start"/> → <t t-out="state.data.cohort.end"/> · WITA · <t t-out="state.data.cohort.count"/> root DOs</p>
    <div class="id-wms__cards">
        <div class="id-wms__card"><span class="id-wms__card-title">OTIF at scheduled timestamp</span><strong class="id-wms__card-value" t-out="pct(state.data.cohort.otif)"/><span class="small">Due DOs: <t t-out="state.data.cohort.otif_due"/></span></div>
        <div class="id-wms__card"><span class="id-wms__card-title">Completed by H+1</span><strong class="id-wms__card-value" t-out="pct(state.data.cohort.h1)"/><span class="small">Mature cohort: <t t-out="state.data.cohort.h1_due"/></span></div>
        <div class="id-wms__card"><span class="id-wms__card-title">Completed by H+2</span><strong class="id-wms__card-value" t-out="pct(state.data.cohort.h2)"/><span class="small">Mature cohort: <t t-out="state.data.cohort.h2_due"/></span></div>
        <div class="id-wms__card"><span class="id-wms__card-title">Open backlog</span><strong class="id-wms__card-value" t-out="state.data.cohort.backlog"/><span class="small">p90 age (days): <t t-out="state.data.cohort.backlog_p90_days ?? '—'"/></span></div>
    </div>
    <p class="small">Completion offset from schedule (hours): median <t t-out="hours(state.data.cohort.lead_median_hours)"/> · p90 <t t-out="hours(state.data.cohort.lead_p90_hours)"/>. Cancelled chains: <t t-out="state.data.cohort.cancelled"/> (<t t-out="pct(state.data.cohort.cancel_rate)"/>). Unknown demand: <t t-out="state.data.cohort.unknown_demand"/>.</p>
    <p class="text-muted small">A cancellation remains in the cohort and cannot count as success. Closed partial chains are failures, not open backlog. Return receipts and first-attempt/POD reasons are separate sources.</p>
    <button class="btn btn-sm btn-outline-secondary" t-on-click="openCohort">Delivery cohort source</button>
    <details><summary>Recorded DO rejection reasons</summary><p class="small">Distinct root DOs per reason; one root may have multiple reasons across backorders.</p><ul><li t-foreach="state.data.cohort.reasons" t-as="r" t-key="r.reason"><t t-out="cohortReason(r.reason)"/>: <t t-out="r.count"/></li></ul></details>
</section>


<section class="id-wms__section" t-if="state.data.pod_attempts" aria-label="Accepted POD bridge"><h2 class="id-wms__section-title">Accepted POD Events</h2><p class="small">Selected root/backorder DO documents. First attempt is the earliest server-accepted evidence event, not GPS arrival or inventory completion. Corrections replace an attempt outcome; reported reasons remain separate from native stock quantities. Media and recipient details are not exposed.</p><div class="id-wms__cards"><div class="id-wms__card"><span>DOs with evidence</span><strong class="id-wms__card-value"><t t-out="state.data.pod_attempts.observed_deliveries"/> / <t t-out="state.data.pod_attempts.delivery_documents"/></strong></div><div class="id-wms__card"><span>Attempts / Corrections</span><strong class="id-wms__card-value"><t t-out="state.data.pod_attempts.attempts"/> / <t t-out="state.data.pod_attempts.corrections"/></strong></div><div class="id-wms__card"><span>Invalid correction lineage</span><strong class="id-wms__card-value" t-out="state.data.pod_attempts.invalid_lineage"/></div></div><details><summary>Reported outcomes and reasons</summary><p t-foreach="Object.entries(state.data.pod_attempts.outcomes)" t-as="r" t-key="r[0]"><t t-out="podOutcome(r[0])"/>: <t t-out="r[1]"/></p><p t-foreach="Object.entries(state.data.pod_attempts.do_reasons)" t-as="r" t-key="r[0]"><t t-out="podOutcome(r[0])"/>: <t t-out="r[1]"/></p><p t-foreach="Object.entries(state.data.pod_attempts.item_reasons)" t-as="r" t-key="r[0]"><t t-out="podOutcome(r[0])"/>: <t t-out="r[1]"/></p></details><button class="btn btn-sm btn-outline-secondary" t-on-click="openPodAttempts">Accepted POD Events</button></section>
<section class="id-wms__section" t-if="state.data.assets" aria-label="Physical asset utilization">
    <h2 class="id-wms__section-title">Physical asset utilization</h2>
    <p class="small text-muted">Stock snapshot: <t t-out="state.data.assets.as_of"/> UTC. Whole-warehouse capacity ignores the category filter. Storage includes reserved and consigned goods under each warehouse stock root, excludes receiving/output areas. Missing dimensions and negative stock prevent a complete occupancy ratio.</p>
    <div class="table-responsive" tabindex="0" role="region" aria-label="Warehouse occupancy"><table class="table table-sm"><thead><tr><th>Warehouse</th><th>Known m³</th><th>Known kg</th><th>Usable m³</th><th>Occupancy</th><th>Quality exceptions</th></tr></thead><tbody>
        <tr t-foreach="state.data.assets.warehouses" t-as="w" t-key="w.id"><td><button class="btn btn-sm btn-link" t-on-click="() => this.openAssetQuants(w)" t-out="w.name"/></td><td t-out="physical(w.volume)"/><td t-out="physical(w.kg)"/><td t-out="physical(w.capacity)"/><td t-out="pct(w.occupancy)"/><td><t t-out="w.missing_volume"/> missing volume · <t t-out="w.missing_weight"/> missing weight · <t t-out="w.negative"/> negative positions</td></tr>
    </tbody></table></div>
    <button class="btn btn-sm btn-outline-secondary" t-on-click="openAssetCapacity">Usable Storage Capacity</button>
    <h3 class="h6 mt-3">Frozen departure loads</h3>
    <p class="small">Departure cohort follows the delivery date controls and vehicle filter; stock category does not apply. Carton-equivalent volume is not actual stacking geometry. Fleet ratios use summed load / summed capacity only for fully measured trips; no average of percentages.</p>
    <div class="id-wms__cards">
        <div class="id-wms__card"><span class="id-wms__card-title">Volume utilization</span><strong class="id-wms__card-value" t-out="pct(state.data.assets.volume_pct)"/><span>Coverage: <t t-out="state.data.assets.volume_covered"/> / <t t-out="state.data.assets.trip_count"/></span></div>
        <div class="id-wms__card"><span class="id-wms__card-title">Weight utilization</span><strong class="id-wms__card-value" t-out="pct(state.data.assets.weight_pct)"/><span>Coverage: <t t-out="state.data.assets.weight_covered"/> / <t t-out="state.data.assets.trip_count"/></span></div>
        <div class="id-wms__card"><span class="id-wms__card-title">Closed-trip distance (km)</span><strong class="id-wms__card-value" t-out="hours(state.data.assets.km)"/><span>Closed: <t t-out="state.data.assets.closed_count"/> / <t t-out="state.data.assets.trip_count"/></span></div>
        <div class="id-wms__card"><span class="id-wms__card-title">Recorded cost / km</span><strong class="id-wms__card-value" t-out="assetMoney(state.data.assets.cost_per_km)"/></div>
    </div>
    <p class="small">Recorded direct trip cost: <t t-out="assetMoney(state.data.assets.direct_cost)"/> · Native completed maintenance: <t t-out="assetMoney(state.data.assets.maintenance)"/> · Recorded cost / delivered DPP: <t t-out="pct(state.data.assets.cost_per_delivered_dpp)"/>.</p>
    <details><summary>Asset metric basis and coverage</summary><p class="small">Distance is operator-entered return minus departure odometer in km, not inferred GPS mileage. Costs are recorded trip expenses plus completed fleet services dated in the period, not a reconciled GL total. Maintenance is not allocated again to trips. Legacy unlinked trip-cost rows remain in the existing fleet report and are not added here. Ratios require every cohort trip closed; missing service access or delivery-price linkage produces unavailable. Foreign-currency SO values are not relabelled as company currency. Delivery DPP is physical gross delivery value at closure, not invoice revenue or net margin.</p></details>
    <div class="table-responsive" tabindex="0" role="region" aria-label="Frozen trip loads"><table class="table table-sm"><thead><tr><th>Trip</th><th>State</th><th>Known m³</th><th>Known kg</th><th>Volume %</th><th>Weight %</th><th>km</th></tr></thead><tbody>
        <tr t-foreach="state.data.assets.trips" t-as="t" t-key="t.id"><td><button class="btn btn-sm btn-link" t-on-click="() => this.openAssetTrip(t.id)" t-out="t.name"/></td><td t-out="assetState(t.state)"/><td t-out="physical(t.volume)"/><td t-out="physical(t.kg)"/><td t-out="pct(t.volume_pct)"/><td t-out="pct(t.weight_pct)"/><td t-out="hours(t.km)"/></tr>
    </tbody></table></div>
    <p class="small">Trips shown: <t t-out="state.data.assets.trips.length"/> / <t t-out="state.data.assets.trip_count"/>. Totals include the full selected cohort.</p>
    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.openAssetTrip()">Load and Trip Records</button>
</section>
                    <!-- BABAK 3: DETAIL TABS & ACTION QUEUES -->
                    <section class="id-wms__section" t-att-class="{'is-loading': state.loading}">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h2 class="id-wms__section-title mb-0"><i class="fa fa-table"/> Antrean Detail Operasional &amp; Investigasi</h2>
                                <span class="id-wms__section-sub">Detail lot FEFO, analisis penyebab tolakan toko, komposisi stok kategori, dan biaya armada.</span>
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn"
                                        t-att-class="state.activeTab === 'expiry' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => state.activeTab = 'expiry'">Monitoring FEFO</button>
                                <button type="button" class="btn"
                                        t-att-class="state.activeTab === 'rejections' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => state.activeTab = 'rejections'">Alasan Tolakan</button>
                                <button type="button" class="btn"
                                        t-att-class="state.activeTab === 'categories' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => state.activeTab = 'categories'">Stok per Kategori</button>
                                <button type="button" class="btn"
                                        t-att-class="state.activeTab === 'fleet' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => state.activeTab = 'fleet'">Efisiensi Armada</button>
                            </div>
                        </div>

                        <!-- Tab 1: FEFO Detail -->
                        <div t-if="state.activeTab === 'expiry'" class="id-wms__table-wrap" tabindex="0" role="region" aria-label="Tabel rincian dashboard">
                            <table class="id-wms__table">
                                <thead>
                                    <tr>
                                        <th>Status Ketahanan Kadaluwarsa</th>
                                        <th class="num">Jumlah Lot/Batch</th>
                                        <th class="num">Total Nilai Persediaan</th>
                                        <th class="num">Pangsa Nilai</th>
                                        <th>Rekomendasi Operasional FMCG</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.expiry_buckets" t-as="b" t-key="b.key"
                                        t-on-click="openExpiryMatrix" style="cursor: pointer;">
                                        <td class="name" t-out="b.label"/>
                                        <td class="num" t-out="int(b.count)"/>
                                        <td class="num font-weight-bold" t-out="money(b.value)"/>
                                        <td class="num" t-out="pct(b.share)"/>
                                        <td>
                                            <span t-if="b.key === 'critical'" class="id-wms__status-pill is-critical">Wajib Retur ke Principal</span>
                                            <span t-elif="b.key === 'warning'" class="id-wms__status-pill is-warning">Program Bundling / Diskon Cepat</span>
                                            <span t-else="" class="id-wms__status-pill is-good">Rotasi Penjualan Normal</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Tab 2: Rejections Breakdown -->
                        <div t-if="state.activeTab === 'rejections'" class="id-wms__table-wrap" tabindex="0" role="region" aria-label="Tabel rincian dashboard">
                            <table class="id-wms__table">
                                <thead>
                                    <tr>
                                        <th>Alasan Tolakan / Retur Pengantaran</th>
                                        <th class="num">Jumlah Kejadian</th>
                                        <th class="num">Pangsa Alasan</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.rejections" t-as="r" t-key="r.reason"
                                        t-on-click="openRejectAnalysis" style="cursor: pointer;">
                                        <td class="name" t-out="r.label"/>
                                        <td class="num font-weight-bold" t-out="int(r.count)"/>
                                        <td class="num" t-out="pct(r.share)"/>
                                    </tr>
                                    <tr t-if="!state.data.rejections.length">
                                        <td colspan="3" class="id-wms__empty">Tidak ada data penolakan pengiriman tercatat.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Tab 3: Stock Categories -->
                        <div t-if="state.activeTab === 'categories'" class="id-wms__table-wrap" tabindex="0" role="region" aria-label="Tabel rincian dashboard">
                            <table class="id-wms__table">
                                <thead>
                                    <tr>
                                        <th>Kategori FMCG</th>
                                        <th class="num">Jumlah SKU</th>
                                        <th class="num">Kuantitas Fisik</th>
                                        <th class="num">Total Nilai Stok</th>
                                        <th class="num">Pangsa Nilai</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.categories" t-as="cat" t-key="cat.key"
                                        t-on-click="openStockCategories" style="cursor: pointer;">
                                        <td class="name text-capitalize"><t t-out="cat.category"/><small class="d-block text-muted" t-out="cat.company"/></td>
                                        <td class="num" t-out="int(cat.product_count)"/>
                                        <td class="num" t-out="int(cat.qty)"/>
                                        <td class="num font-weight-bold" t-out="money(cat.value)"/>
                                        <td class="num" t-out="pct(cat.share)"/>
                                    </tr>
                                    <tr t-if="!state.data.categories.length">
                                        <td colspan="5" class="id-wms__empty">Tidak ada data kategori stok.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Tab 4: Fleet Efficiency -->
                        <div t-if="state.activeTab === 'fleet'" class="id-wms__table-wrap" tabindex="0" role="region" aria-label="Tabel rincian dashboard">
                            <table class="id-wms__table">
                                <thead>
                                    <tr>
                                        <th>Kendaraan Armada</th>
                                        <th class="num">Biaya BBM</th>
                                        <th class="num">Biaya Helper</th>
                                        <th class="num">Biaya BBM + Helper</th>
                                        <th class="num">Nilai DO Terkirim</th>
                                        <th class="num">Rasio Biaya / Nilai</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.fleet" t-as="f" t-key="f.key"
                                        t-on-click="openFleetCostAnalysis" style="cursor: pointer;">
                                        <td class="name" t-out="f.name + ' · ' + f.period_month"/>
                                        <td class="num" t-out="money(f.fuel_cost)"/>
                                        <td class="num" t-out="money(f.helper_cost)"/>
                                        <td class="num text-danger font-weight-bold" t-out="money(f.total_cost)"/>
                                        <td class="num font-weight-bold" t-out="money(f.delivered_value)"/>
                                        <td class="num" t-out="pct(f.cost_ratio)"/>
                                    </tr>
                                    <tr t-if="!state.data.fleet.length">
                                        <td colspan="6" class="id-wms__empty">Tidak ada data biaya armada untuk filter terpilih.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
<section t-if="state.data.warehouse_depth" class="id-wms__section" aria-label="Warehouse operational detail">
    <t t-set="wd" t-value="state.data.warehouse_depth"/>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><h2 class="id-wms__section-title">Warehouse operational detail</h2><div class="d-flex flex-wrap gap-2">
        <button class="btn btn-sm btn-outline-secondary" t-on-click="openStorageMaster">Storage master</button>
        <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.openWarehouseSource('stock.move.line', wd.movement_domain)">Movement sources</button>
        <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.openWarehouseSource('id.warehouse.clock', wd.clock_domain)">Operation clocks</button>
    </div></div>
    <p class="small text-muted">Current stock and capacity · warehouse selector applies to this section only. Category applies to SKU risk and movements; capacity includes all stock. Movements and completed clocks use the selected cohort dates. Vehicle filter does not apply.</p>
    <div class="row g-3 my-1">
        <div class="col-6 col-lg-3"><span class="small text-muted">Expired / expires within 30 days</span><div class="fs-5"><t t-out="int(wd.risk.expired_positions)"/> / <t t-out="int(wd.risk.expiry_30_positions)"/></div><small>Positive stock positions</small></div>
        <div class="col-6 col-lg-3"><span class="small text-muted">Slow / inactive SKUs</span><div class="fs-5"><t t-out="int(wd.risk.slow_skus)"/> / <t t-out="int(wd.risk.inactive_skus)"/></div><small>Warehouse observation policy</small></div>
        <div class="col-6 col-lg-3"><span class="small text-muted">Stock position age · median / p90 days</span><div class="fs-5"><t t-out="hours(wd.quant_age_median_days)"/> / <t t-out="hours(wd.quant_age_p90_days)"/></div><small>Unweighted quant in-date proxy</small></div>
        <div class="col-6 col-lg-3"><span class="small text-muted">Missing expected expiry / unknown age</span><div class="fs-5"><t t-out="int(wd.risk.missing_expected_expiry)"/> / <t t-out="int(wd.risk.unknown_age)"/></div><small>Negative positions: <t t-out="int(wd.risk.negative_positions)"/></small></div>
    </div>
    <details open="open"><summary>Location capacity and layout readiness</summary>
        <p class="small text-muted"><t t-out="int(wd.verified_locations)"/> / <t t-out="int(wd.locations_total)"/> sourced layouts verified · warehouses with conflicting frames: <t t-out="int(wd.frame_conflicts)"/>. Parent rows include descendants; do not sum nested rows. Volume is carton-equivalent; pallet slots count physical outer pallets. Missing or negative stock prevents a complete ratio.</p>
        <div class="table-responsive" style="max-height: 22rem; overflow:auto"><table class="table table-sm align-middle"><thead><tr><th>Location / warehouse</th><th>Volume / usable m³</th><th>Weight / limit kg</th><th>Pallets / slots</th><th>Coverage exceptions</th><th>Layout / source</th></tr></thead><tbody>
            <tr t-foreach="wd.locations" t-as="row" t-key="row.id"><td><button class="btn btn-link btn-sm text-start p-0" t-on-click="() => this.openWarehouseSource('stock.quant', row.quant_domain)" t-out="row.name"/><div class="small text-muted" t-out="row.warehouse"/></td><td><t t-out="physical(row.volume)"/> / <t t-out="physical(row.capacity)"/><div t-out="pct(row.volume_pct)"/></td><td><t t-out="physical(row.kg)"/> / <t t-out="physical(row.max_kg)"/><div t-out="pct(row.weight_pct)"/></td><td><t t-out="int(row.pallets)"/> / <t t-out="physical(row.slots)"/><div t-out="pct(row.slot_pct)"/></td><td class="small">Volume: <t t-out="int(row.missing_volume)"/> · weight: <t t-out="int(row.missing_weight)"/> · pallet: <t t-out="int(row.unclassified_pallets)"/> · negative: <t t-out="int(row.negative)"/></td><td class="small"><span t-if="row.verified">Verified · <t t-out="row.frame"/></span><span t-else="">Unverified</span><div t-out="row.source || '—'"/></td></tr>
            <tr t-if="!wd.locations.length"><td colspan="6" class="text-muted">No physical storage positions in scope.</td></tr>
        </tbody></table></div><p t-if="wd.locations_total > 200" class="small">First 200 locations shown; narrow the warehouse scope for review.</p>
    </details>
    <details open="open" class="mt-3"><summary>Movement throughput and operation time</summary>
        <p class="small text-muted">Actual done movement lines by WITA date; one line counted once. No mixed-SKU quantity total. Event elapsed time includes waiting; unrecorded historical operations have no duration.</p>
        <div class="row g-3"><div class="col-12 col-xl-7"><div class="small d-flex flex-wrap gap-3 mb-2"><span><i class="fa fa-square text-primary"/> Received</span><span><i class="fa fa-square text-success"/> Shipped</span><span><i class="fa fa-square text-info"/> Putaway</span><span><i class="fa fa-square text-warning"/> Picking</span><span><i class="fa fa-square text-secondary"/> Other</span></div><div style="max-height: 17rem; overflow:auto">
            <div t-foreach="wd.daily" t-as="day" t-key="day.date" class="d-flex align-items-center gap-2 mb-2"><span class="small flex-shrink-0" t-out="day.date"/><div class="d-flex flex-grow-1" style="height:1.3rem"><t t-foreach="['received','shipped','putaway','picking','other_transfer_or_adjustment']" t-as="kind" t-key="kind"><div t-att-class="'warehouse-flow warehouse-flow--' + kind" t-att-style="'width:' + ((day[kind] || 0) / warehouseFlowMax * 100) + '%'" t-att-title="flowKind(kind) + ': ' + (day[kind] || 0)" role="img" t-att-aria-label="day.date + ' ' + flowKind(kind) + ': ' + (day[kind] || 0)"/></t></div><span class="small" t-out="(day.received || 0)+(day.shipped || 0)+(day.putaway || 0)+(day.picking || 0)+(day.other_transfer_or_adjustment || 0)"/></div>
            <p t-if="!wd.daily.length" class="text-muted small">No completed movements in this period.</p>
        </div></div><div class="col-12 col-xl-5"><table class="table table-sm"><thead><tr><th>Clock</th><th>Completed</th><th>Median min</th><th>p90 min</th></tr></thead><tbody><tr t-foreach="wd.clocks" t-as="clock" t-key="clock.kind"><td t-out="clockKind(clock.kind)"/><td t-out="int(clock.count)"/><td t-out="hours(clock.median_minutes)"/><td t-out="hours(clock.p90_minutes)"/></tr></tbody></table><p class="small">Currently running: <t t-out="int(wd.running_clocks)"/> · cancelled in period: <t t-out="int(wd.cancelled_clocks)"/></p></div></div>
    </details>
    <details class="mt-3"><summary>SKU stock health and availability</summary><p class="small text-muted">Current stock UoM per SKU and warehouse. Slow/inactive means aged stock with no recent observed customer outbound within the configured window; it does not mean never sold.</p><div class="table-responsive" style="max-height:20rem; overflow:auto"><table class="table table-sm"><thead><tr><th>SKU / warehouse</th><th>On hand</th><th>Reserved</th><th>Available</th><th>Oldest days</th><th>Observed last outbound</th><th>Observation</th></tr></thead><tbody><tr t-foreach="wd.skus" t-as="row" t-key="row.key"><td><button class="btn btn-link btn-sm p-0 text-start" t-on-click="() => this.openWarehouseSource('stock.quant', row.domain)" t-out="row.name"/><div class="small text-muted" t-out="row.warehouse"/></td><td><t t-out="physical(row.quantity)"/> <t t-out="row.unit"/></td><td t-out="physical(row.reserved)"/><td t-out="physical(row.available)"/><td t-out="physical(row.oldest_age)"/><td t-out="row.last_outbound || '—'"/><td><span t-if="row.inactive" class="badge text-bg-danger">Inactive</span><span t-elif="row.slow" class="badge text-bg-warning">Slow</span><div class="small"><t t-out="row.lookback_days"/> days</div></td></tr><tr t-if="!wd.skus.length"><td colspan="7" class="text-muted">No stock positions in scope.</td></tr></tbody></table></div><p t-if="wd.skus_total > 200" class="small">First 200 SKU rows shown, oldest exceptions first.</p></details>
    <details class="mt-3"><summary>Native inventory valuation / ledger control</summary><p class="small text-muted">Company-wide current native inventory value versus posted mapped stock-valuation accounts. Warehouse, category and cohort filters do not apply. Difference requires reconciliation; it is not an automatic loss or adjustment.</p><p t-if="!wd.ledger.available" class="small text-muted">Accounting access required.</p><div t-foreach="wd.ledger.rows" t-as="row" t-key="row.company_id" class="mb-2"><strong t-out="row.company"/><t t-if="row.available"><div>Native value: <t t-out="assetMoney(row.native_value)"/> · ledger: <t t-out="assetMoney(row.ledger_value)"/> · difference: <t t-out="assetMoney(row.gap)"/></div><button class="btn btn-link btn-sm p-0" t-on-click="() => this.openWarehouseSource('account.move.line', row.domain)">Posted valuation entries</button></t><p t-else="" class="small text-muted">Valuation account mapping incomplete. Missing products: <t t-out="int(row.missing_accounts)"/></p></div></details>
    <p class="small text-muted mt-2">Current source snapshot: <t t-out="wd.as_of"/> UTC · movement / clock period: <t t-out="wd.start"/> – <t t-out="wd.end"/> WITA</p>
</section>
                </t>
            </div>
        </div>
    </t>
</templates>
