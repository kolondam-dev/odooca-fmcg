<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="id_dashboard_wms.WmsDashboard">
        <div class="o_action id-wms">
            <div class="id-wms__scroll">
                <!-- Header -->
                <header class="id-wms__header">
                    <div>
                        <h1 class="id-wms__title">Warehouse &amp; Logistics (WMS) Dashboard</h1>
                        <p class="id-wms__subtitle">
                            Operasional Gudang, Monitoring FEFO Kadaluwarsa, &amp; Logistik Pengiriman FMCG
                        </p>
                    </div>
                    <div class="id-wms__quick-links">
                        <button type="button" class="id-wms__quick-btn" t-on-click="openExpiryMatrix">
                            <span>⏳ FEFO Expiry (Pivot)</span>
                        </button>
                        <button type="button" class="id-wms__quick-btn" t-on-click="openDeliveryFulfillment">
                            <span>🚚 Delivery Fulfillment</span>
                        </button>
                        <button type="button" class="id-wms__quick-btn" t-on-click="openRejectAnalysis">
                            <span>❌ Analisis Retur/Reject</span>
                        </button>
                        <button type="button" class="id-wms__quick-btn" t-on-click="openFleetCostAnalysis">
                            <span>🚐 Biaya Armada</span>
                        </button>
                        <button type="button" class="id-wms__quick-btn" t-on-click="openStockCategories">
                            <span>📦 Stok per Kategori</span>
                        </button>
                    </div>
                </header>

                <!-- Filters -->
                <section class="id-wms__filters" aria-label="Filters">
                    <div class="id-wms__filter-group">
                        <span class="id-wms__filter-label">Kategori FMCG:</span>
                        <select class="id-wms__select" t-att-value="state.fmcgCategory" t-on-change="onCategoryChange">
                            <option value="">Semua Kategori</option>
                            <t t-foreach="state.filters.categories" t-as="c" t-key="c.key">
                                <option t-att-value="c.key" t-out="c.label"/>
                            </t>
                        </select>
                    </div>
                    <div class="id-wms__filter-group">
                        <span class="id-wms__filter-label">Kendaraan Armada:</span>
                        <select class="id-wms__select" t-att-value="state.vehicleId || ''" t-on-change="onVehicleChange">
                            <option value="">Semua Armada</option>
                            <t t-foreach="state.filters.vehicles" t-as="v" t-key="v.id">
                                <option t-att-value="v.id" t-out="v.name"/>
                            </t>
                        </select>
                    </div>
                    <button type="button" class="id-wms__quick-btn" t-on-click="reset">Reset Filter</button>
                </section>

                <div t-if="state.error" class="alert alert-danger" role="alert" t-out="state.error"/>
                <div t-if="state.loading and !state.data" class="id-wms__empty">Memuat data WMS &amp; logistik…</div>

                <t t-if="state.data">
                    <div class="id-wms__body" t-att-class="{'opacity-50': state.loading}">
                        <!-- Primary KPI Cards -->
                        <section class="id-wms__cards id-wms__cards--primary">
                            <button type="button" class="id-wms__card id-wms__card--navy" t-on-click="openStockCategories">
                                <span class="id-wms__card-label">Total Nilai Persediaan</span>
                                <span class="id-wms__card-value" t-out="moneyShort(state.data.kpi.total_stock_value)"/>
                                <span class="id-wms__card-meta"><t t-out="int(state.data.kpi.total_stock_qty)"/> unit di gudang</span>
                            </button>
                            <button type="button" class="id-wms__card id-wms__card--red" t-on-click="openExpiryMatrix">
                                <span class="id-wms__card-label">Stok Kritis (&lt; 30 Hari)</span>
                                <span class="id-wms__card-value" t-out="moneyShort(state.data.kpi.critical_expiry_val)"/>
                                <span class="id-wms__card-meta"><t t-out="int(state.data.kpi.critical_expiry_count)"/> batch wajib retur principal</span>
                            </button>
                            <button type="button" class="id-wms__card id-wms__card--emerald" t-on-click="openDeliveryFulfillment">
                                <span class="id-wms__card-label">Tingkat Pemenuhan DO</span>
                                <span class="id-wms__card-value" t-out="pct(state.data.kpi.fulfillment_rate)"/>
                                <span class="id-wms__card-meta"><t t-out="int(state.data.kpi.delivered_count)"/> dari <t t-out="int(state.data.kpi.total_deliveries)"/> pesanan terkirim</span>
                            </button>
                            <button type="button" class="id-wms__card id-wms__card--amber" t-on-click="openFleetCostAnalysis">
                                <span class="id-wms__card-label">Rasio Biaya Armada</span>
                                <span class="id-wms__card-value" t-out="pct(state.data.kpi.fleet_cost_ratio)"/>
                                <span class="id-wms__card-meta">Total Biaya: <t t-out="moneyShort(state.data.kpi.total_trip_cost)"/></span>
                            </button>
                        </section>

                        <!-- FEFO Health & Expiry Distribution Bar -->
                        <section class="id-wms__panel">
                            <div class="id-wms__panel-head">
                                <h2 class="id-wms__panel-title">Monitoring Ketahanan Stok FEFO (First-Expired, First-Out)</h2>
                                <span class="text-muted font-monospace" t-out="money(state.data.kpi.total_stock_value)"/>
                            </div>
                            <div class="id-wms__fefo-bar-wrap">
                                <t t-foreach="state.data.expiry_buckets" t-as="b" t-key="b.key">
                                    <div t-attf-class="id-wms__fefo-bar-segment seg-#{b.key}"
                                         t-att-style="'width:' + b.share + '%'"
                                         t-att-title="b.label + ': ' + money(b.value) + ' (' + pct(b.share) + ')'"/>
                                </t>
                            </div>
                            <div class="id-wms__fefo-legend">
                                <t t-foreach="state.data.expiry_buckets" t-as="b" t-key="b.key">
                                    <div class="id-wms__legend-item">
                                        <span t-attf-class="id-wms__legend-dot dot-#{b.key}"/>
                                        <span><t t-out="b.label"/>: <strong><t t-out="moneyShort(b.value)"/></strong> (<t t-out="pct(b.share)"/>, <t t-out="int(b.count)"/> lot)</span>
                                    </div>
                                </t>
                            </div>
                        </section>

                        <!-- Secondary KPI Metrics: Delivery Details -->
                        <section class="id-wms__cards id-wms__cards--secondary">
                            <div class="id-wms__card id-wms__card--blue" style="cursor: default;">
                                <span class="id-wms__card-label">Nilai Terkirim Selesai</span>
                                <span class="id-wms__card-value" t-out="moneyShort(state.data.kpi.delivered_value)"/>
                                <span class="id-wms__card-meta"><t t-out="int(state.data.kpi.delivered_count)"/> DO sukses sampai tujuan</span>
                            </div>
                            <div class="id-wms__card id-wms__card--amber" style="cursor: default;">
                                <span class="id-wms__card-label">Pengiriman Terlambat</span>
                                <span class="id-wms__card-value" t-out="int(state.data.kpi.late_count)"/>
                                <span class="id-wms__card-meta">DO selesai lewat jadwal tanggal</span>
                            </div>
                            <div class="id-wms__card id-wms__card--red" style="cursor: default;">
                                <span class="id-wms__card-label">Total Tolakan Pengiriman</span>
                                <span class="id-wms__card-value" t-out="int(state.data.kpi.total_rejections)"/>
                                <span class="id-wms__card-meta">Tingkat Tolakan: <t t-out="pct(state.data.kpi.rejection_rate)"/></span>
                            </div>
                        </section>

                        <!-- Detail Tabs & Tables -->
                        <section class="id-wms__panel">
                            <div class="id-wms__panel-head">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm"
                                            t-att-class="state.activeTab === 'expiry' ? 'btn-primary' : 'btn-outline-secondary'"
                                            t-on-click="() => state.activeTab = 'expiry'">Monitoring FEFO &amp; Tindakan</button>
                                    <button type="button" class="btn btn-sm"
                                            t-att-class="state.activeTab === 'rejections' ? 'btn-primary' : 'btn-outline-secondary'"
                                            t-on-click="() => state.activeTab = 'rejections'">Alasan Tolakan / Retur</button>
                                    <button type="button" class="btn btn-sm"
                                            t-att-class="state.activeTab === 'categories' ? 'btn-primary' : 'btn-outline-secondary'"
                                            t-on-click="() => state.activeTab = 'categories'">Stok per Kategori FMCG</button>
                                    <button type="button" class="btn btn-sm"
                                            t-att-class="state.activeTab === 'fleet' ? 'btn-primary' : 'btn-outline-secondary'"
                                            t-on-click="() => state.activeTab = 'fleet'">Efisiensi Armada Logistik</button>
                                </div>
                            </div>

                            <!-- Tab 1: FEFO Detail -->
                            <div t-if="state.activeTab === 'expiry'" class="id-wms__table-wrap">
                                <table class="id-wms__table">
                                    <thead>
                                        <tr>
                                            <th>Status Ketahanan Kadaluwarsa</th>
                                            <th class="num">Jumlah Lot/Batch</th>
                                            <th class="num">Total Nilai Persediaan</th>
                                            <th class="num">Pangsa Nilai</th>
                                            <th>Rekomendasi Operasional FMCG</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.expiry_buckets" t-as="b" t-key="b.key"
                                            t-on-click="openExpiryMatrix" style="cursor: pointer;">
                                            <td class="name" t-out="b.label"/>
                                            <td class="num" t-out="int(b.count)"/>
                                            <td class="num font-weight-bold" t-out="money(b.value)"/>
                                            <td class="num" t-out="pct(b.share)"/>
                                            <td>
                                                <span t-if="b.key === 'critical'" class="badge bg-danger">Wajib Retur ke Principal</span>
                                                <span t-elif="b.key === 'warning'" class="badge bg-warning text-dark">Program Bundling / Diskon Cepat</span>
                                                <span t-else="" class="badge bg-success">Rotasi Penjualan Normal</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Tab 2: Rejections Breakdown -->
                            <div t-if="state.activeTab === 'rejections'" class="id-wms__table-wrap">
                                <table class="id-wms__table">
                                    <thead>
                                        <tr>
                                            <th>Alasan Tolakan / Retur Pengantaran</th>
                                            <th class="num">Jumlah Kejadian</th>
                                            <th class="num">Pangsa Alasan</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.rejections" t-as="r" t-key="r.reason"
                                            t-on-click="openRejectAnalysis" style="cursor: pointer;">
                                            <td class="name" t-out="r.label"/>
                                            <td class="num font-weight-bold" t-out="int(r.count)"/>
                                            <td class="num" t-out="pct(r.share)"/>
                                        </tr>
                                        <tr t-if="!state.data.rejections.length">
                                            <td colspan="3" class="id-wms__empty">Tidak ada data penolakan pengiriman tercatat.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Tab 3: Stock Categories -->
                            <div t-if="state.activeTab === 'categories'" class="id-wms__table-wrap">
                                <table class="id-wms__table">
                                    <thead>
                                        <tr>
                                            <th>Kategori FMCG</th>
                                            <th class="num">Jumlah SKU</th>
                                            <th class="num">Kuantitas Fisik</th>
                                            <th class="num">Total Nilai Stok</th>
                                            <th class="num">Pangsa Nilai</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.categories" t-as="cat" t-key="cat.category"
                                            t-on-click="openStockCategories" style="cursor: pointer;">
                                            <td class="name text-capitalize" t-out="cat.category"/>
                                            <td class="num" t-out="int(cat.product_count)"/>
                                            <td class="num" t-out="int(cat.qty)"/>
                                            <td class="num font-weight-bold" t-out="money(cat.value)"/>
                                            <td class="num" t-out="pct(cat.share)"/>
                                        </tr>
                                        <tr t-if="!state.data.categories.length">
                                            <td colspan="5" class="id-wms__empty">Tidak ada data kategori stok.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Tab 4: Fleet Efficiency -->
                            <div t-if="state.activeTab === 'fleet'" class="id-wms__table-wrap">
                                <table class="id-wms__table">
                                    <thead>
                                        <tr>
                                            <th>Kendaraan Armada</th>
                                            <th>Periode Bulan</th>
                                            <th class="num">Total Biaya Operasional</th>
                                            <th class="num">Nilai Pengiriman Berhasil</th>
                                            <th class="num">Rasio Biaya / Nilai</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.fleet" t-as="f" t-key="f.vehicle + f.month"
                                            t-on-click="openFleetCostAnalysis" style="cursor: pointer;">
                                            <td class="name" t-out="f.vehicle"/>
                                            <td t-out="f.month"/>
                                            <td class="num text-danger" t-out="money(f.cost)"/>
                                            <td class="num font-weight-bold" t-out="money(f.delivered_value)"/>
                                            <td class="num" t-out="pct(f.ratio)"/>
                                        </tr>
                                        <tr t-if="!state.data.fleet.length">
                                            <td colspan="5" class="id-wms__empty">Tidak ada data biaya armada untuk filter terpilih.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>

