<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="id_dashboard_monetary.MonetaryDashboard">
        <div class="o_action id-md">
            <div class="id-md__sheet">
                <!-- Header & Unified Grouped Filter Bar -->
                <header class="id-md__header">
                    <div class="id-md__header-main">
                        <div class="id-md__header-title-wrap">
                            <span class="id-md__badge-dept"><i class="fa fa-money"/> DIVISI KEUANGAN &amp; KONTROL PIUTANG</span>
                            <h1 class="id-md__title">Monetary &amp; Accounts Receivable Cockpit</h1>
                            <span class="id-md__subtitle">Monitoring likuiditas kas, mitigasi risiko gagal bayar (bad debt), dan penegakan batas kredit outlet.</span>
                        </div>
                        <div class="id-md__header-quick">
                            <button type="button" class="id-md__quick-btn" t-on-click="openAgingMatrix">
                                <i class="fa fa-table"/> AR Aging Matrix
                            </button>
                            <button type="button" class="id-md__quick-btn" t-on-click="openFunnel">
                                <i class="fa fa-filter"/> Financial Funnel
                            </button>
                            <button type="button" class="id-md__quick-btn" t-on-click="openAllInvoices">
                                <i class="fa fa-list"/> Semua Piutang
                            </button>
                        </div>
                    </div>

                    <!-- Filter Bar Clusters -->
                    <div class="id-md__filter-bar">
                        <!-- Cluster 1: Area -->
                        <div class="id-md__filter-cluster">
                            <span class="id-md__cluster-label"><i class="fa fa-map-marker"/> Coverage Area (<t t-out="state.areaIds.length ? state.areaIds.length : 'Semua'"/>)</span>
                            <div class="id-md__cluster-content">
                                <t t-foreach="state.filters.areas" t-as="a" t-key="a.id">
                                    <button type="button" class="id-md__chip"
                                            t-att-class="{'is-active': state.areaIds.includes(a.id)}"
                                            t-on-click="() => this.toggleArea(a.id)" t-out="a.name"/>
                                </t>
                            </div>
                        </div>

                        <!-- Cluster 2: Salesperson -->
                        <div class="id-md__filter-cluster">
                            <span class="id-md__cluster-label"><i class="fa fa-user"/> Salesperson (<t t-out="state.salesmanIds.length ? state.salesmanIds.length : 'Semua'"/>)</span>
                            <div class="id-md__cluster-content">
                                <t t-foreach="state.filters.salesmen" t-as="s" t-key="s.id">
                                    <button type="button" class="id-md__chip"
                                            t-att-class="{'is-active': state.salesmanIds.includes(s.id)}"
                                            t-on-click="() => this.toggleSalesman(s.id)" t-out="s.name"/>
                                </t>
                            </div>
                        </div>

                        <!-- Cluster 3: Action -->
                        <div class="id-md__filter-actions">
                            <button type="button" class="id-md__btn-reset" t-on-click="reset">
                                <i class="fa fa-undo"/> Reset Filter
                            </button>
                        </div>
                    </div>
                </header>

                <div t-if="state.error" class="alert alert-danger mb-0" role="alert" t-out="state.error"/>
                <div t-if="state.loading and !state.data" class="id-md__empty"><i class="fa fa-circle-o-notch fa-spin"/> Memuat data keuangan &amp; piutang…</div>

                <t t-if="state.data">
                    <!-- BABAK 1: LIQUIDITY & AR SAFETY PULSE -->
                    <section class="id-md__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-md__head">
                            <h2 class="id-md__section-title"><i class="fa fa-credit-card"/> Babak 1: Saldo Piutang Beredar &amp; Likuiditas Kas</h2>
                            <span class="id-md__section-sub">Total saldo piutang berjalan, rasio jatuh tempo, eksposur risiko macet, dan kas tertagih.</span>
                        </div>
                        <div class="id-md__cards">
                            <button type="button" class="id-md__card" t-on-click="openAllInvoices">
                                <div class="id-md__card-header">
                                    <span class="id-md__card-title">Piutang Faktur Terbuka</span>
                                    <span class="id-md__micro-badge is-navy"><i class="fa fa-balance-scale"/></span>
                                </div>
                                <div class="id-md__card-body">
                                    <span class="id-md__card-value" t-out="moneyShort(state.data.kpi.total_ar)"/>
                                </div>
                                <div class="id-md__card-footer">
                                    <t t-out="int(state.data.kpi.invoices_count)"/> faktur terbuka · aging <t t-out="state.data.as_of"/>
                                </div>
                            </button>
                            <button type="button" class="id-md__card" t-on-click="openOverdueInvoices">
                                <div class="id-md__card-header">
                                    <span class="id-md__card-title">Piutang Jatuh Tempo</span>
                                    <span class="id-md__micro-badge is-red"><i class="fa fa-exclamation-circle"/></span>
                                </div>
                                <div class="id-md__card-body">
                                    <span class="id-md__card-value is-danger" t-out="moneyShort(state.data.kpi.overdue_ar)"/>
                                </div>
                                <div class="id-md__card-footer">
                                    <t t-out="pct(state.data.kpi.overdue_ratio)"/> dari total saldo piutang
                                </div>
                            </button>
                            <button type="button" class="id-md__card" t-on-click="openOverdueInvoices">
                                <div class="id-md__card-header">
                                    <span class="id-md__card-title">Risiko Macet (&gt;30 Hari)</span>
                                    <span class="id-md__micro-badge is-darkred"><i class="fa fa-shield"/></span>
                                </div>
                                <div class="id-md__card-body">
                                    <span class="id-md__card-value is-danger" t-out="moneyShort(state.data.kpi.bad_debt)"/>
                                </div>
                                <div class="id-md__card-footer">
                                    <t t-out="pct(state.data.kpi.bad_debt_ratio)"/> eksposur audit SPV / Potensi Macet
                                </div>
                            </button>
                            <button type="button" class="id-md__card" t-on-click="openFunnel">
                                <div class="id-md__card-header">
                                    <span class="id-md__card-title">Pembayaran Masuk Tercatat</span>
                                    <span class="id-md__micro-badge is-emerald"><i class="fa fa-check-circle"/></span>
                                </div>
                                <div class="id-md__card-body">
                                    <span class="id-md__card-value is-ok" t-out="moneyShort(state.data.kpi.cash_collected)"/>
                                </div>
                                <div class="id-md__card-footer">
                                    Termasuk pembayaran dalam proses; bukan verifikasi bank
                                </div>
                            </button>
                        </div>
                    </section>

                    <!-- BABAK 2: AGING DISTRIBUTION & CONVERSION FUNNEL -->
                    <section class="id-md__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-md__head">
                            <h2 class="id-md__section-title"><i class="fa fa-clock-o"/> Babak 2: Komposisi Umur Piutang (FMCG Aging Matrix)</h2>
                            <span class="id-md__section-sub">Proporsi faktur belum jatuh tempo vs peringatan dini (1-7h), credit hold (8-14h), dan potensi macet.</span>
                        </div>
                        <div class="id-md__aging-bar-wrap">
                            <t t-foreach="state.data.buckets" t-as="b" t-key="b.key">
                                <div t-attf-class="id-md__aging-bar-segment seg-#{b.key}"
                                     t-att-style="'width:' + b.percent + '%'"
                                     t-att-title="b.label + ': ' + money(b.amount) + ' (' + pct(b.percent) + ')'"/>
                            </t>
                        </div>
                        <div class="id-md__aging-legend">
                            <t t-foreach="state.data.buckets" t-as="b" t-key="b.key">
                                <div class="id-md__legend-item">
                                    <span t-attf-class="id-md__legend-dot dot-#{b.key}"/>
                                    <span><t t-out="b.label"/>: <strong><t t-out="moneyShort(b.amount)"/></strong> (<t t-out="pct(b.percent)"/> · <t t-out="int(b.count)"/> faktur)</span>
                                </div>
                            </t>
                        </div>
                    </section>

                    <!-- BABAK 2B: FINANCIAL TARGET & CONVERSION -->
                    <section class="id-md__section" t-att-class="{'is-loading': state.loading}">
                        <div class="id-md__head">
                            <h2 class="id-md__section-title"><i class="fa fa-bullseye"/> Target &amp; Realisasi Periode</h2>
                            <label>Periode target
                                <select class="form-select form-select-sm" t-on-change="onPeriodChange" t-att-value="state.periodKey">
                                    <option t-if="!state.filters.periods.length" value="">Belum ada target</option>
                                    <option t-foreach="state.filters.periods" t-as="p" t-key="p.key" t-att-value="p.key" t-out="p.label"/>
                                </select>
                            </label>
                            <span class="id-md__section-sub">Realisasi invoice bersih DPP dan pembayaran periode terpilih. Filter area/salesman hanya berlaku pada piutang.</span>
                        </div>
                        <div class="id-md__cards id-md__cards--3">
                            <div class="id-md__card">
                                <div class="id-md__card-header">
                                    <span class="id-md__card-title">Target Penjualan</span>
                                    <span class="id-md__micro-badge is-blue"><i class="fa fa-flag"/></span>
                                </div>
                                <div class="id-md__card-body">
                                    <span class="id-md__card-value" t-out="moneyShort(state.data.kpi.target_revenue)"/>
                                </div>
                                <div class="id-md__card-footer">
                                    Target company pada periode terpilih
                                </div>
                            </div>
                            <div class="id-md__card">
                                <div class="id-md__card-header">
                                    <span class="id-md__card-title">Realisasi Faktur</span>
                                    <span class="id-md__micro-badge is-amber"><i class="fa fa-shopping-cart"/></span>
                                </div>
                                <div class="id-md__card-body">
                                    <span class="id-md__card-value" t-out="moneyShort(state.data.kpi.realized_revenue)"/>
                                </div>
                                <div class="id-md__card-footer">
                                    Pencapaian: <strong><t t-out="pct(state.data.kpi.achievement_rate)"/></strong> dari target
                                </div>
                            </div>
                            <div class="id-md__card">
                                <div class="id-md__card-header">
                                    <span class="id-md__card-title">Pencairan Kas (Collection)</span>
                                    <span class="id-md__micro-badge is-emerald"><i class="fa fa-money"/></span>
                                </div>
                                <div class="id-md__card-body">
                                    <span class="id-md__card-value is-ok" t-out="moneyShort(state.data.kpi.cash_collected)"/>
                                </div>
                                <div class="id-md__card-footer">
                                    Kas pelunasan berhasil dikonfirmasi
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- BABAK 3: ACTION QUEUE & TOP CUSTOMER EXPOSURE -->
                    <section class="id-md__section" t-att-class="{'is-loading': state.loading}">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h2 class="id-md__section-title mb-0"><i class="fa fa-list-alt"/> Babak 3: Antrean Mitigasi Risiko Kredit (Credit Hold Queue)</h2>
                                <span class="id-md__section-sub">Daftar outlet mendekati plafon dan evaluasi eksposur per wilayah atau salesman.</span>
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn"
                                        t-att-class="state.subTab === 'customers' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => state.subTab = 'customers'">Top 10 Outlet &amp; Plafon</button>
                                <button type="button" class="btn"
                                        t-att-class="state.subTab === 'areas' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => state.subTab = 'areas'">Sebaran per Wilayah</button>
                                <button type="button" class="btn"
                                        t-att-class="state.subTab === 'salesmen' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => state.subTab = 'salesmen'">Sebaran per Salesman</button>
                            </div>
                        </div>

                        <!-- SubTab 1: Customers / Credit Hold -->
                        <div t-if="state.subTab === 'customers'" class="id-md__table-wrap">
                            <table class="id-md__table">
                                <thead>
                                    <tr>
                                        <th>Outlet / Pelanggan</th>
                                        <th>Channel</th>
                                        <th>Area</th>
                                        <th>Salesperson</th>
                                        <th class="num">Faktur</th>
                                        <th class="num">Total Piutang</th>
                                        <th class="num">Jatuh Tempo</th>
                                        <th class="num">Credit Limit</th>
                                        <th class="num">Utilisasi</th>
                                        <th>Status Plafon</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.top_customers" t-as="c" t-key="c.key"
                                        t-on-click="() => this.openCustomerInvoices(c.id, c.name, c.company_id)">
                                        <td class="name" t-out="c.name"/>
                                        <td t-out="c.channel"/>
                                        <td t-out="c.area"/>
                                        <td t-out="c.salesman"/>
                                        <td class="num" t-out="int(c.open_count)"/>
                                        <td class="num font-weight-bold" t-out="money(c.total_balance)"/>
                                        <td class="num text-danger font-weight-bold" t-out="money(c.overdue_balance)"/>
                                        <td class="num" t-out="money(c.credit_limit)"/>
                                        <td class="num" t-out="pct(c.utilization)"/>
                                        <td>
                                            <span t-if="c.credit_hold" class="id-md__status-pill is-hold">CREDIT HOLD</span>
                                            <span t-else="" class="id-md__status-pill is-normal">Lancar</span>
                                        </td>
                                    </tr>
                                    <tr t-if="!state.data.top_customers.length">
                                        <td colspan="10" class="id-md__empty">Tidak ada saldo piutang terbuka untuk filter terpilih.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- SubTab 2: Areas -->
                        <div t-if="state.subTab === 'areas'" class="id-md__table-wrap">
                            <table class="id-md__table">
                                <thead>
                                    <tr>
                                        <th>Wilayah Coverage Area</th>
                                        <th class="num">Jumlah Faktur</th>
                                        <th class="num">Total Piutang</th>
                                        <th class="num">Piutang Jatuh Tempo</th>
                                        <th class="num">Rasio Overdue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.areas" t-as="a" t-key="a.id">
                                        <td class="name" t-out="a.name"/>
                                        <td class="num" t-out="int(a.count)"/>
                                        <td class="num font-weight-bold" t-out="money(a.total_ar)"/>
                                        <td class="num text-danger" t-out="money(a.overdue_ar)"/>
                                        <td class="num" t-out="pct(a.overdue_ratio)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- SubTab 3: Salesmen -->
                        <div t-if="state.subTab === 'salesmen'" class="id-md__table-wrap">
                            <table class="id-md__table">
                                <thead>
                                    <tr>
                                        <th>Salesperson</th>
                                        <th class="num">Jumlah Faktur</th>
                                        <th class="num">Total Piutang</th>
                                        <th class="num">Piutang Jatuh Tempo</th>
                                        <th class="num">Rasio Overdue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.salesmen" t-as="s" t-key="s.id">
                                        <td class="name" t-out="s.name"/>
                                        <td class="num" t-out="int(s.count)"/>
                                        <td class="num font-weight-bold" t-out="money(s.total_ar)"/>
                                        <td class="num text-danger" t-out="money(s.overdue_ar)"/>
                                        <td class="num" t-out="pct(s.overdue_ratio)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </t>
            </div>
        </div>
    </t>
</templates>
