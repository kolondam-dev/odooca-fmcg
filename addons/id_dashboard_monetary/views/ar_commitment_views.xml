<odoo>
    <record id="view_ar_audit_list" model="ir.ui.view"><field name="name">ar.audit.list</field><field name="model">id.ar.audit.snapshot</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="name"/><field name="company_id"/><field name="kind"/><field name="as_of"/><field name="captured_at"/><field name="captured_by"/><field name="digest"/></list></field></record>
    <record id="view_ar_audit_form" model="ir.ui.view"><field name="name">ar.audit.form</field><field name="model">id.ar.audit.snapshot</field><field name="arch" type="xml"><form create="false" edit="false" delete="false" duplicate="false"><header><button name="action_verify" type="object" string="Verify Evidence Digest"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="kind"/><field name="as_of"/><field name="captured_at"/><field name="captured_by"/><field name="digest"/></group><field name="payload_json"/></sheet></form></field></record>
    <record id="action_ar_audits" model="ir.actions.act_window"><field name="name">Frozen AR Evidence</field><field name="res_model">id.ar.audit.snapshot</field><field name="view_mode">list,form</field></record>
    <record id="view_ar_promise_list" model="ir.ui.view"><field name="name">ar.promise.list</field><field name="model">id.ar.promise</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="line_id"/><field name="owner_id"/><field name="due_date"/><field name="currency_id" column_invisible="True"/><field name="amount"/><field name="settled_amount"/><field name="outcome"/></list></field></record>
    <record id="view_ar_promise_form" model="ir.ui.view"><field name="name">ar.promise.form</field><field name="model">id.ar.promise</field><field name="arch" type="xml"><form duplicate="false"><header><button name="action_commit" type="object" string="Commit Promise" invisible="state != 'draft'"/><button name="action_capture_assessment" type="object" string="Freeze Assessment" invisible="state != 'committed'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'"/><field name="line_id" readonly="state != 'draft'" domain="[('company_id','=',company_id),('account_id.account_type','=','asset_receivable'),('parent_state','=','posted'),('balance','&gt;',0)]"/><field name="owner_id" readonly="state != 'draft'"/><field name="currency_id" invisible="1"/><field name="amount" readonly="state != 'draft'"/><field name="due_date" readonly="state != 'draft'"/><field name="source" readonly="state != 'draft'"/><field name="committed_date"/><field name="outcome"/><field name="settled_amount"/></group><p>Only new allocations from currently paid, bank-matched inbound payments count. Credit notes and write-offs do not fulfil a payment promise. Freeze an assessment to retain the observed result.</p></sheet></form></field></record>
    <record id="action_ar_promises" model="ir.actions.act_window"><field name="name">Customer Payment Promises</field><field name="res_model">id.ar.promise</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_ar_audits" name="Frozen AR Evidence" parent="menu_fmcg_monetary" action="action_ar_audits" sequence="80" groups="account.group_account_user,base.group_system"/>
    <menuitem id="menu_ar_promises" name="Customer Payment Promises" parent="menu_fmcg_monetary" action="action_ar_promises" sequence="81" groups="account.group_account_user,base.group_system"/>
</odoo>
