<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Executive OWL Client Action -->
    <record id="action_monetary_dashboard" model="ir.actions.client">
        <field name="name">Monetary &amp; AR Dashboard</field>
        <field name="tag">id_dashboard_monetary.monetary_dashboard</field>
    </record>

    <!-- Group Dashboards under Odoo Root Dashboards -->
    <menuitem id="menu_root_dash_monetary"
              name="Monetary &amp; AR"
              parent="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"
              action="action_monetary_dashboard"
              sequence="20"
              groups="account.group_account_invoice,sales_team.group_sale_salesman"/>

    <!-- Group Dashboards under FMCG Distribution -->
    <menuitem id="menu_fmcg_dash_monetary"
              name="Monetary &amp; AR"
              parent="id_base.menu_fmcg_dashboard"
              action="action_monetary_dashboard"
              sequence="20"
              groups="account.group_account_invoice,sales_team.group_sale_salesman"/>

    <!-- Monetary & AR Menu Section in FMCG Distribution -->
    <menuitem id="menu_fmcg_monetary"
              name="Monetary &amp; AR"
              parent="id_base.menu_fmcg_root"
              sequence="20"/>

    <!-- Submenu 1: Executive Interactive Dashboard -->
    <menuitem id="menu_monetary_executive_dashboard"
              name="Executive Dashboard"
              parent="menu_fmcg_monetary"
              action="action_monetary_dashboard"
              sequence="1"/>

    <!-- Submenus 2+: Drilldown & Analytical Data (Preserved Existing Views) -->
    <menuitem id="menu_ar_aging"
              name="AR Aging Matrix"
              parent="menu_fmcg_monetary"
              action="action_id_ar_aging"
              sequence="10"/>

    <menuitem id="menu_ar_by_salesman"
              name="AR by Salesperson"
              parent="menu_fmcg_monetary"
              action="action_id_ar_by_salesman"
              sequence="20"/>

    <menuitem id="menu_ar_by_area"
              name="AR by Coverage Area"
              parent="menu_fmcg_monetary"
              action="action_id_ar_by_area"
              sequence="30"/>

    <menuitem id="menu_ar_top_customers"
              name="Top 10 Customers"
              parent="menu_fmcg_monetary"
              action="action_id_ar_customer_balance"
              sequence="40"/>

    <menuitem id="menu_monetary_funnel"
              name="Financial Funnel"
              parent="menu_fmcg_monetary"
              action="action_id_monetary_funnel"
              sequence="50"/>

    <menuitem id="menu_monetary_target"
              name="Revenue Targets"
              parent="menu_fmcg_monetary"
              action="action_id_monetary_target"
              sequence="90"
              groups="base.group_system"/>
</odoo>
