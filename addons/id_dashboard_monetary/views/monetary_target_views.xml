<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_id_monetary_target_list" model="ir.ui.view">
        <field name="name">id.monetary.target.list</field>
        <field name="model">id.monetary.target</field>
        <field name="arch" type="xml">
            <list string="Revenue Targets">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="target_revenue" sum="Total Target"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_id_monetary_target_form" model="ir.ui.view">
        <field name="name">id.monetary.target.form</field>
        <field name="model">id.monetary.target</field>
        <field name="arch" type="xml">
            <form string="Revenue Target">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Revenue Target Q3-Q4 2026"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="target_revenue"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Source and assumptions for this target"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_id_monetary_target" model="ir.actions.act_window">
        <field name="name">Revenue Targets</field>
        <field name="res_model">id.monetary.target</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set a revenue target period</p>
            <p>Every funnel compares realized revenue against the target of the active period.</p>
        </field>
    </record>
</odoo>
