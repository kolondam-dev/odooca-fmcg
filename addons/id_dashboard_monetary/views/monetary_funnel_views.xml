<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_id_monetary_funnel_graph" model="ir.ui.view">
        <field name="name">id.monetary.funnel.stage.graph</field>
        <field name="model">id.monetary.funnel.stage</field>
        <field name="arch" type="xml">
            <graph string="Financial Funnel" type="bar">
                <field name="stage"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_id_monetary_funnel_list" model="ir.ui.view">
        <field name="name">id.monetary.funnel.stage.list</field>
        <field name="model">id.monetary.funnel.stage</field>
        <field name="arch" type="xml">
            <list string="Financial Funnel" create="0" edit="0" delete="0">
                <field name="sequence" column_invisible="1"/>
                <field name="stage"/>
                <field name="period_name"/>
                <field name="amount" sum="Total"/>
                <field name="target_amount"/>
                <field name="achievement_percent"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_id_monetary_funnel_search" model="ir.ui.view">
        <field name="name">id.monetary.funnel.stage.search</field>
        <field name="model">id.monetary.funnel.stage</field>
        <field name="arch" type="xml">
            <search string="Financial Funnel">
                <field name="target_id"/>
                <field name="period_name"/>
                <filter name="filter_realized" string="Realized Revenue" domain="[('stage', '=', 'realized')]"/>
                <filter name="filter_receivable" string="Receivable" domain="[('stage', '=', 'receivable')]"/>
                <filter name="filter_collection" string="Cash Collection" domain="[('stage', '=', 'collection')]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'period_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_id_monetary_funnel" model="ir.actions.act_window">
        <field name="name">Financial Funnel</field>
        <field name="res_model">id.monetary.funnel.stage</field>
        <field name="view_mode">graph,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No revenue target period yet</p>
            <p>The funnel compares the revenue target with realized revenue, the open receivable
               balance, and cash collection for the same period.</p>
        </field>
    </record>
</odoo>
