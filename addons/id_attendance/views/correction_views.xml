<odoo>
    <record id="action_attendance_corrections" model="ir.actions.act_window">
        <field name="name">My Attendance Corrections</field>
        <field name="res_model">id.attendance.correction</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_attendance_correction_list" model="ir.ui.view">
        <field name="name">id.attendance.correction.list</field>
        <field name="model">id.attendance.correction</field>
        <field name="arch" type="xml">
            <list edit="0" delete="0">
                <field name="business_date"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_correction_form" model="ir.ui.view">
        <field name="name">id.attendance.correction.form</field>
        <field name="model">id.attendance.correction</field>
        <field name="arch" type="xml">
            <form edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="oe_highlight" invisible="approval_id"/>
                    <button name="action_open_approval" type="object" string="Open Approval"
                            invisible="not approval_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="approval_id" invisible="1"/>
                    <group>
                        <field name="business_date"/>
                        <field name="start_hour" widget="float_time"/>
                        <field name="end_hour" widget="float_time"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <menuitem id="menu_attendance_corrections" name="My Attendance Corrections"
              parent="id_approval.menu_fmcg_approval_operations" action="action_attendance_corrections"
              groups="base.group_user" sequence="30"/>
    <record id="view_attendance_approval_request" model="ir.ui.view">
        <field name="name">fmcg.approval.request.form.attendance</field>
        <field name="model">fmcg.approval.request</field>
        <field name="inherit_id" ref="id_approval.view_fmcg_approval_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_approve']" position="attributes">
                <attribute name="invisible" add="category_code == 'attendance_correction'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_reject']" position="attributes">
                <attribute name="invisible" add="category_code == 'attendance_correction'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible" add="category_code == 'attendance_correction'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_approve']" position="after">
                <button name="action_open_correction_decision" type="object" class="oe_highlight"
                        string="Review Attendance Correction"
                        invisible="category_code != 'attendance_correction' or not is_current_user_approver"/>
            </xpath>
        </field>
    </record>
    <record id="view_attendance_decision_form" model="ir.ui.view">
        <field name="name">id.attendance.correction.decision.form</field>
        <field name="model">id.attendance.correction.decision</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="approval_id" force_save="1"/>
                    <field name="tier" force_save="1"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"/>
                    <button name="action_reject" type="object" string="Reject"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
