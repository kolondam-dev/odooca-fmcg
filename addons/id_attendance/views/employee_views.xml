<odoo>
    <record id="employee_form_pwa_attendance" model="ir.ui.view">
        <field name="name">hr.employee.form.pwa.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="work_location_id" position="after">
                <field name="pwa_attendance_office_id" domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_open': True}"/>
            </field>
        </field>
    </record>
</odoo>
