<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_report_wizard_form" model="ir.ui.view">
        <field name="name">id.finance.report.wizard.form</field>
        <field name="model">id.finance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Finance Report">
                <sheet>
                    <group>
                        <group>
                            <field name="report_type" widget="selection"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="company_ids" widget="many2many_tags"
                                   invisible="report_type != 'combined_trial_balance'"/>
                            <field name="date_from"
                                   invisible="report_type in ('open_items', 'aged_partner_balance', 'accrual_schedule', 'fx_revaluation')"/>
                            <field name="date_to"
                                   invisible="report_type in ('open_items', 'aged_partner_balance', 'accrual_schedule', 'fx_revaluation')"/>
                            <field name="as_of_date"
                                   invisible="report_type not in ('open_items', 'aged_partner_balance', 'accrual_schedule', 'fx_revaluation')"/>
                            <field name="partner_type"
                                   invisible="report_type not in ('partner_ledger', 'open_items', 'aged_partner_balance')"/>
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags"
                                   invisible="report_type not in ('partner_ledger', 'open_items', 'aged_partner_balance', 'accrual_schedule', 'fx_revaluation')"/>
                            <field name="journal_ids" widget="many2many_tags"
                                   domain="[('company_id', '=', company_id)]"/>
                            <field name="account_ids" widget="many2many_tags"
                                   invisible="report_type not in ('audit_trail', 'accrual_schedule', 'fx_revaluation')"
                                   domain="[('company_ids', 'in', [company_id])]"/>
                            <field name="register_type"
                                   invisible="report_type != 'sales_purchase_register'"/>
                            <field name="presentation_currency_id"
                                   invisible="report_type != 'combined_trial_balance'"/>
                            <field name="rate_date"
                                   invisible="report_type != 'combined_trial_balance'"/>
                            <field name="hide_account_at_0"
                                   invisible="report_type != 'combined_trial_balance'"/>
                            <field name="only_posted_moves"/>
                        </group>
                    </group>
                    <group invisible="report_type != 'combined_trial_balance'">
                        <field name="account_map_json" placeholder='{"100100": ["100100", "Cash", "asset_cash"]}'/>
                    </group>
                    <notebook>
                        <page string="Result">
                            <field name="result_summary" readonly="1" nolabel="1"/>
                            <field name="result_html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Payload (JSON)">
                            <field name="result_json" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_run" string="Run Report" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_export_xlsx" string="Export XLSX" type="object" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_finance_report_audit_trail" model="ir.actions.act_window">
        <field name="name">Journal Items Audit Trail (FIN04)</field>
        <field name="res_model">id.finance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'audit_trail'}</field>
    </record>

