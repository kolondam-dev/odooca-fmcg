<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_menu_systray')]" position="attributes">
            <attribute name="t-ref">id_systray</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_menu_systray')]" position="before">
            <IdMenuSearch/>
        </xpath>
    </t>
    <t t-inherit="web.UserMenu" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('o_user_avatar')]" position="before">
            <span class="id_user_meta">
                <b t-esc="userName"/>
                <small t-esc="idRoleLabel"/>
            </span>
        </xpath>
    </t>
</templates>
