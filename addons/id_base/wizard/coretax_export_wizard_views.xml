<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coretax_export_wizard_form" model="ir.ui.view">
        <field name="name">coretax.export.wizard.form</field>
        <field name="model">coretax.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Legacy Tax CSV (Unverified)">
                <div class="alert alert-info" role="status">
                    Legacy CSV generation is disabled. Use the native Indonesian Coretax workflow.
                    Historical exports are unverified and do not prove official acceptance.
                </div>
                <group>
                    <field name="state" readonly="1"/>
                    <field name="date_from" readonly="1"/>
                    <field name="date_to" readonly="1"/>
                    <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                    <field name="total_invoices" readonly="1"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_coretax_export_wizard" model="ir.actions.act_window">
        <field name="name">Legacy Tax CSV (Disabled)</field>
        <field name="res_model">coretax.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_action_coretax_export_sales"
              name="Legacy Tax CSV (Disabled)"
              parent="sale.menu_sale_report"
              action="action_coretax_export_wizard"
              groups="account.group_account_manager"
              sequence="50"/>
</odoo>
