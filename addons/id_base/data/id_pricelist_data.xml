<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 1. FMCG Default Base Price -->
    <record id="pricelist_fmcg_base" model="product.pricelist">
        <field name="name">FMCG Default Base Price (Standard Retail)</field>
        <field name="currency_id" ref="base.IDR"/>
        <field name="is_fmcg_matrix">True</field>
        <field name="channel_id" ref="channel_rtl"/>
        <field name="coverage_category">all</field>
        <field name="tier">cash</field>
        <field name="date_start">2026-08-01</field>
        <field name="date_end">2027-07-31</field>
        <field name="alert_days_before">14</field>
    </record>

    <record id="item_fmcg_base_rule" model="product.pricelist.item">
        <field name="pricelist_id" ref="pricelist_fmcg_base"/>
        <field name="applied_on">3_global</field>
        <field name="compute_price">formula</field>
        <field name="base">list_price</field>
        <field name="price_discount">0.0</field>
        <field name="date_start">2026-08-01 00:00:00</field>
        <field name="date_end">2027-07-31 23:59:59</field>
    </record>

