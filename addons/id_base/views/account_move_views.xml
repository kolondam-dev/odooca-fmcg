<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fmcg_tax_inherit" model="ir.ui.view">
        <field name="name">account.move.form.fmcg.tax.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Header button generate NSFP -->
            <xpath expr="//header" position="inside">
                <button name="action_generate_nsfp"
                        type="object"
                        string="Generate NSFP CoreTax"
                        class="btn-secondary"
                        invisible="move_type != 'out_invoice' or l10n_id_tax_invoice_number or state != 'posted'"/>
            </xpath>

            <!-- Tab Faktur Pajak & CoreTax DJP -->
            <xpath expr="//notebook" position="inside">
                <page string="Faktur Pajak &amp; CoreTax" name="fmcg_coretax" invisible="move_type != 'out_invoice'">
                    <group>
                        <group string="Identitas Faktur Pajak Elektronik">
                            <field name="l10n_id_tax_transaction_code"/>
                            <field name="l10n_id_tax_invoice_number" placeholder="mis. 010.000-26.00000001"/>
                            <field name="l10n_id_tax_invoice_date"/>
                            <field name="l10n_id_coretax_exported" widget="boolean_toggle"/>
                        </group>
                        <group string="Keterangan &amp; Petunjuk">
                            <div class="text-muted">
                                Bidang ini digunakan untuk integrasi modul perpajakan Indonesia e-Faktur dan CoreTax DJP.
                                Nomor seri faktur pajak dapat dihasilkan otomatis dengan tombol di atas atau diisi manual sesuai jatah NSFP resmi.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

