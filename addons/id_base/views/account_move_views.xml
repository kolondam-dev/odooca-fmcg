<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fmcg_tax_inherit" model="ir.ui.view">
        <field name="name">account.move.form.fmcg.tax.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Legacy Tax Data (Unverified)" name="fmcg_coretax" invisible="move_type != 'out_invoice'">
                    <group>
                        <group string="Preserved Legacy Values">
                            <field name="l10n_id_tax_transaction_code" readonly="1"/>
                            <field name="l10n_id_tax_invoice_number" readonly="1"/>
                            <field name="l10n_id_tax_invoice_date" readonly="1"/>
                            <field name="l10n_id_coretax_exported" readonly="1"/>
                        </group>
                        <group string="Workflow Status">
                            <div class="text-muted">
                                Legacy custom values are unverified. Use the native Indonesian Coretax workflow.
                                An exported file is not proof of official acceptance.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

