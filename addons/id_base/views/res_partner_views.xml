<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_fmcg_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.fmcg.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="FMCG Distribution" name="fmcg_distribution">
                    <group>
                        <group string="Outlet Classification">
                            <field name="channel_id"/>
                            <field name="coverage_area_id"/>
                            <field name="district_id"/>
                            <field name="subdistrict_id" domain="[('district_id', '=?', district_id)]"/>
                            <field name="credit_mode"/>
                        </group>
                        <group string="PIC &amp; Operations">
                            <field name="pic_name"/>
                            <field name="pic_phone"/>
                            <field name="delivery_notes" placeholder="e.g. Accessible by 4-wheel box, unload via back alley..."/>
                        </group>
                    </group>
                    <group>
                        <group string="Matriks Harga Komersial">
                            <field name="property_product_pricelist" string="Matriks Daftar Harga"/>
                            <div>
                                <button name="action_assign_matrix_pricelist" type="object" string="Pasang Matriks Harga Otomatis" class="btn btn-secondary" icon="fa-calculator"/>
                            </div>
                        </group>
                        <group string="Authorized Principals">
                            <field name="principal_ids" widget="many2many_tags" placeholder="Select authorized principals for this outlet..."/>
                        </group>
                    </group>
                    <group string="Permanent Journey Plan (PJP) &amp; Logistik Rute">
                        <group>
                            <field name="pjp_call_day"/>
                            <field name="pjp_frequency"/>
                        </group>
                        <group>
                            <field name="delivery_route"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_fmcg_pjp" model="ir.ui.view">
        <field name="name">res.partner.select.fmcg.pjp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='customer']" position="after">
                <separator/>
                <filter string="PJP Senin" name="pjp_monday" domain="[('pjp_call_day', '=', 'monday')]"/>
                <filter string="PJP Selasa" name="pjp_tuesday" domain="[('pjp_call_day', '=', 'tuesday')]"/>
                <filter string="PJP Rabu" name="pjp_wednesday" domain="[('pjp_call_day', '=', 'wednesday')]"/>
                <filter string="PJP Kamis" name="pjp_thursday" domain="[('pjp_call_day', '=', 'thursday')]"/>
                <filter string="PJP Jumat" name="pjp_friday" domain="[('pjp_call_day', '=', 'friday')]"/>
                <filter string="PJP Sabtu" name="pjp_saturday" domain="[('pjp_call_day', '=', 'saturday')]"/>
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter string="PJP Call Day" name="group_by_pjp_call_day" context="{'group_by': 'pjp_call_day'}"/>
                <filter string="PJP Frequency" name="group_by_pjp_frequency" context="{'group_by': 'pjp_frequency'}"/>
                <filter string="Delivery Route" name="group_by_delivery_route" context="{'group_by': 'delivery_route'}"/>
            </xpath>
        </field>
    </record>
</odoo>
