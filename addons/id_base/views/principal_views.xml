<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Principal Views -->
    <record id="view_id_principal_tree" model="ir.ui.view">
        <field name="name">id.principal.list</field>
        <field name="model">id.principal</field>
        <field name="arch" type="xml">
            <list string="Principals">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pks_number"/>
                <field name="pks_end"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_id_principal_form" model="ir.ui.view">
        <field name="name">id.principal.form</field>
        <field name="model">id.principal</field>
        <field name="arch" type="xml">
            <form string="Principal">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Principal Name"/>
                        <h1><field name="name" placeholder="e.g. PT Mayora Indah Tbk"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                        <group string="PKS Contract">
                            <field name="pks_number"/>
                            <field name="pks_start"/>
                            <field name="pks_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Brands" name="brands">
                            <field name="brand_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_id_principal" model="ir.actions.act_window">
        <field name="name">Principals</field>
        <field name="res_model">id.principal</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new FMCG Principal.
            </p>
        </field>
    </record>

    <!-- Brand Views -->
    <record id="view_id_brand_tree" model="ir.ui.view">
        <field name="name">id.brand.list</field>
        <field name="model">id.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="principal_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_id_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">id.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
