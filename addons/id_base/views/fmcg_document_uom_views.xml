<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fmcg_uom_breakdown" model="ir.ui.view">
        <field name="name">account.move.form.fmcg.uom.breakdown</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id']" position="after">
                <field name="fmcg_qty_breakdown" string="Rincian Kemasan" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_fmcg_uom_breakdown" model="ir.ui.view">
        <field name="name">stock.picking.form.fmcg.uom.breakdown</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom']" position="after">
                <field name="fmcg_qty_breakdown" string="Rincian Kemasan" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
