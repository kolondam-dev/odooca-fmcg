<odoo>
    <record id="view_mobile_workday_list" model="ir.ui.view">
        <field name="name">id.mobile.workday.list</field>
        <field name="model">id.mobile.workday</field>
        <field name="arch" type="xml">
            <list><field name="business_date"/><field name="user_id"/><field name="company_id"/>
                <field name="warehouse_id"/><field name="pricelist_id"/><field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_mobile_workday_form" model="ir.ui.view">
        <field name="name">id.mobile.workday.form</field>
        <field name="model">id.mobile.workday</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="active"/><field name="business_date"/>
                <field name="user_id"/><field name="company_id"/><field name="warehouse_id"/>
                <field name="pricelist_id"/><field name="outlet_radius"/>
            </group><group string="Explicit read scope">
                <field name="outlet_ids" widget="many2many_tags"/>
                <field name="product_ids" widget="many2many_tags"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_mobile_workday" model="ir.actions.act_window">
        <field name="name">Mobile Read Assignments</field>
        <field name="res_model">id.mobile.workday</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_mobile_workday" name="Mobile Read Assignments"
              parent="base.menu_administration" action="action_mobile_workday" groups="base.group_system"/>
</odoo>
