<odoo>
    <record id="view_mobile_office_list" model="ir.ui.view">
        <field name="name">id.mobile.office.list</field><field name="model">id.mobile.office</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="coordinate_status"/><field name="radius"/><field name="active"/></list></field>
    </record>
    <record id="view_mobile_office_form" model="ir.ui.view">
        <field name="name">id.mobile.office.form</field><field name="model">id.mobile.office</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="active"/><field name="latitude"/><field name="longitude"/><field name="radius"/><field name="coordinate_status"/><field name="coordinate_note"/></group></sheet></form></field>
    </record>
    <record id="action_mobile_office" model="ir.actions.act_window">
        <field name="name">Mobile Office Locations</field><field name="res_model">id.mobile.office</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_mobile_office" name="Mobile Office Locations" parent="base.menu_administration" action="action_mobile_office" groups="base.group_system"/>
</odoo>
