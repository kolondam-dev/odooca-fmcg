<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
 <t t-name="id_dashboard_redesign.Action">
  <div class="o_action id-dash-action id-d1-scroll" t-att-aria-busy="state.loading">
   <div t-if="state.error" class="alert alert-danger" role="alert" t-out="state.error"/>
   <p t-if="state.loading" class="p-3" role="status">Loading dashboard…</p>
   <ApprovedControls t-if="!state.data and state.filters.dimensions" options="recoveryOptions" onApply.bind="apply"/>
   <DashboardShell t-if="state.data" dashboard="dashboard" data="state.data" onApply.bind="apply" onDrill.bind="openDocument"/>
  </div>
 </t>
 <t t-name="id_dashboard_redesign.SalesSourceDialog">
  <Dialog title="title" size="'md'">
   <p>Matching lines show the products included in the dashboard calculation. Sales Orders shows the complete orders containing those lines.</p>
   <t t-set-slot="footer">
    <button type="button" class="btn btn-primary" t-on-click="() => this.select(true)">Matching sales order lines</button>
    <button type="button" class="btn btn-secondary" t-on-click="() => this.select(false)">Sales Orders</button>
    <button type="button" class="btn btn-link" t-on-click="props.close">Cancel</button>
   </t>
  </Dialog>
 </t>
</templates>