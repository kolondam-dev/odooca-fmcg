<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_finance" model="res.groups.privilege">
        <field name="name">FMCG Finance</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_finance_reader" model="res.groups">
        <field name="name">Finance Reader</field>
        <field name="privilege_id" ref="privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="group_finance_accountant" model="res.groups">
        <field name="name">Finance Accountant</field>
        <field name="privilege_id" ref="privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_reader')), (4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="privilege_id" ref="privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_accountant')), (4, ref('account.group_account_manager'))]"/>
    </record>
    <record id="group_tax_pic" model="res.groups">
        <field name="name">Tax PIC (Read-only Preparation)</field>
        <field name="implied_ids" eval="[(4, ref('group_finance_reader'))]"/>
    </record>
</odoo>
