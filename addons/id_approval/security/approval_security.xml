<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_fmcg_approval_user" model="res.groups">
        <field name="name">Staf Pengaju (User)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_fmcg_approval_supervisor" model="res.groups">
        <field name="name">Penyelia (Supervisor - Tier 1)</field>
        <field name="implied_ids" eval="[(4, ref('group_fmcg_approval_user'))]"/>
    </record>

    <record id="group_fmcg_approval_manager" model="res.groups">
        <field name="name">Manajer Cabang / Departemen (Manager - Tier 2)</field>
        <field name="implied_ids" eval="[(4, ref('group_fmcg_approval_supervisor'))]"/>
    </record>

    <record id="group_fmcg_approval_director" model="res.groups">
        <field name="name">Direksi / Pemilik (Owner / Director - Tier 3)</field>
        <field name="implied_ids" eval="[(4, ref('group_fmcg_approval_manager'))]"/>
    </record>
</odoo>
