<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve"><t t-name="id_dashboard_ui.Bullet"><section class="id-dash-card" t-att-style="'min-height:' + height"><h3 t-out="props.title"/><t t-foreach="rows" t-as="r" t-key="r.index"><div class="id-bullet-row"><b t-out="r.n"/><div class="id-bullet-track"><div t-att-style="'width:' + r.width + '%;background:' + (r.c || 'var(--ac)')"/><i t-if="r.target !== undefined and r.target !== null" t-att-style="'left:' + r.targetPos + '%'"/></div><span t-out="r.t || num(r.v) + '%'"/></div></t></section></t>
</templates>
