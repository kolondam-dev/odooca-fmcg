<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve"><t t-name="id_dashboard_ui.Donut"><section class="id-dash-card id-donut" t-att-style="'min-height:' + height"><h3 t-out="props.title"/><div class="id-donut-body"><div class="id-donut-ring"><svg viewBox="0 0 120 120" role="img" t-att-aria-label="props.title"><circle cx="60" cy="60" r="45" fill="none" stroke="var(--tint2)" stroke-width="22"/><t t-foreach="items" t-as="item" t-key="item.index"><circle cx="60" cy="60" r="45" pathLength="100" fill="none" t-att-stroke="item.color" stroke-width="22" t-att-stroke-dasharray="item.part + ' ' + (100-item.part)" t-att-stroke-dashoffset="-item.offset" transform="rotate(-90 60 60)"/></t></svg><div class="id-donut-center"><b t-out="props.ct"/><small t-out="props.cs"/></div></div><div class="id-donut-legend"><t t-foreach="items" t-as="item" t-key="item.index"><div><i t-att-style="'background:' + item.color"/><span t-out="item.n"/><span t-out="item.t || (num(item.v) + ' · ' + num(item.part) + '%')"/></div></t></div></div></section></t>
</templates>
