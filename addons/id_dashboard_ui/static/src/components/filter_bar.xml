<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve">
  <t t-name="id_dashboard_ui.FilterBar">
    <div t-on-click="handleClick">
      <div style="background:#fff;border-bottom:1px solid #d5e0f2;padding:10px 24px;display:flex;flex-direction:column;gap:8px;font-family:Inter,system-ui,sans-serif;color:#12223f;font-size:13px">
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <button data-command="period" style="font:inherit;font-size:12px;color:#12223f;background:#fff;border:1px solid #b8c8e4;border-radius:4px;padding:6px 10px;min-height:34px;"><b>Period</b> <t t-out="v.period"/> ▾</button>
          <label style="display:flex;align-items:center;gap:6px;font-size:12px"><input type="checkbox" checked="checked"/>Compare</label>
          <button data-command="period" style="font:inherit;font-size:12px;color:#12223f;background:#fff;border:1px solid #b8c8e4;border-radius:4px;padding:6px 10px;min-height:34px;"><t t-out="v.compare"/> ▾</button>
          <button data-command="filter" style="font:inherit;font-size:12px;color:#12223f;background:#fff;border:1px solid #b8c8e4;border-radius:4px;padding:6px 10px;min-height:34px;border-color:var(--ac);color:var(--ac);font-weight:600">+ Filter (<t t-out="v.count"/>)</button>
          <button data-command="save" style="font:inherit;font-size:12px;color:#12223f;background:#fff;border:1px solid #b8c8e4;border-radius:4px;padding:6px 10px;min-height:34px;">Save view ▾</button>
          <button data-command="reset" style="font:inherit;font-size:12px;color:#12223f;background:#fff;border:1px solid #b8c8e4;border-radius:4px;padding:6px 10px;min-height:34px;">Reset</button>
          <span style="margin-left:auto;font-size:11px;color:#52627f">
            <t t-out="v.note"/>
          </span>
        </div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <t t-foreach="v.chips" t-as="c" t-key="c_index">
            <span t-attf-style="display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:4px 9px;border-radius:12px;background:{{ c.bg }};border:{{ c.bd }}">
              <t t-if="c.lock">
                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" viewBox="0 0 24 24">
                  <rect x="5" y="11" width="14" height="9" rx="2"/>
                  <path d="M8 11V8a4 4 0 018 0v3"/>
                </svg>
              </t>
              <t t-out="c.t"/>
              <t t-if="c.x">
                <button aria-label="Remove filter" style="all:unset;cursor:pointer;font-size:14px;line-height:1;padding:0 2px">×</button>
              </t>
            </span>
          </t>
        </div>
      </div>
    </div>
  </t>
</templates>
